@model Dry.Models.ViewModel.ReapplyQueryView
<h2>申請案件重覆申請查詢</h2>
@*ex: 新北市新店區-大坪林十四張, 地號 :115*@
<script>
    $(function () {
        $("#div_NewApplyMsg").hide();
        $('#FarmCityCode').change(function () {
            var val = $('#FarmCityCode option:selected').val();
            GetTownDDL(val);
        });
        $('#FarmTownId').change(function () {
            var val = parseInt($('#FarmTownId option:selected').val());
            GetSecDDL(val);
        });
        $('#btn_FarmQuery').click(function () {
            $("#div_NewApplyMsg").hide();
            $.getJSON('../ReapplyQuery/FarmQuery?FarmSection=' + $('#FarmSection option:selected').val() + '&LandNo=' + $('#LandNo').val(), function (data) {
                
                //var res = data.status.replace('\n', '<br/>');
                //alert(data.status);
                console.log(data.status);
                $('#span_NewApplyMsg').html(data.status);
                $("#div_NewApplyMsg").fadeIn();
            });
        });
        $('#btn_NewApplyMsgClose').click(function () {
            $("#div_NewApplyMsg").fadeOut();
        });

        function GetTownDDL(DDLvalue) {
            $.EnableBlockUI('');
            $.ajaxSettings.async = false;
            $.getJSON('../ReapplyQuery/GetTownDDL?CityCode=' + DDLvalue, function (data) {
                var TownDDL = $('#FarmTownId');
                TownDDL.empty();
                for (i = 0; i < data.length; i++) { //依選擇縣市，列出鄉鎮市
                    TownDDL.append('<option value="' + data[i].Value + '">' + data[i].Text + '</option>');
                }
            });
            $.DisableBlockUI();
        }
        function GetSecDDL(DDLvalue) {
            $.EnableBlockUI('');
            $.ajaxSettings.async = false;
            $.getJSON('../ReapplyQuery/GetSecDDL?townid=' + DDLvalue, function (data) {
                var sectDDL = $('#FarmSection');
                sectDDL.empty();
                for (i = 0; i < data.length; i++) { //依選擇縣市，列出鄉鎮市
                    sectDDL.append('<option value="' + data[i].Value + '">' + data[i].Text + '</option>');
                }
            });
            $.DisableBlockUI();
        }
        
    });
</script>
<div class="content">
    <h4>【新系統查詢】</h4>
    <table border="1" class="dashTable">
        <tr>
            <td class="td_style">
                地段 :
            </td>
            <td>
                <div class="control-group">
                    <div class="controls span12 form-horizontal">
                        @*縣市*@
                        @Html.DropDownListFor(model => model.FarmCityCode, (IEnumerable<SelectListItem>)Model.CityDDL, new { style = "width: 100px;" })
                        @Html.ValidationMessageFor(model => model.FarmCityCode, null, new { @class = "help-inline" })
                        @*鄉鎮市*@
                        @Html.DropDownListFor(model => model.FarmTownId, (IEnumerable<SelectListItem>)Model.TownDDL, new { style = "width: 100px;" })
                        @Html.ValidationMessageFor(model => model.FarmTownId, null, new { @class = "help-inline" })

                        @Html.DropDownListFor(model => model.FarmSection, (IEnumerable<SelectListItem>)Model.SectionList, new { style = "" })
                        @Html.ValidationMessageFor(model => model.FarmSection, null, new { @class = "help-inline" })
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="td_style">
                地號 :
            </td>
            <td>
                <div class="control-group form-inline">
                    <div class="controls">
                        @Html.EditorFor(model => model.LandNo, new { @class = "input-small" })
                        <input id="btn_FarmQuery" type="button" value="查詢" class="btn" />
                        @Html.ValidationMessageFor(model => model.LandNo, null, new { @class = "help-inline" })
                        <h5>範例: 1-1 或 1</h5>
                    </div>
                </div>
            </td>
        </tr>
        
    </table>
    <div id="div_NewApplyMsg" class="alert alert-info" style="width:300px;">
        <button id="btn_NewApplyMsgClose" type="button" class="close">&times;</button>
        <span id="span_NewApplyMsg"></span>
    </div>
</div>
@if ((short)Session["UnitID"] != 17)
{
    <h4>【舊系統查詢】</h4>
    <div class="content">
        @*<iframe id="OldSystemiFrame" src="https://dryfarm.aerc.org.tw/DryMIS/%E6%9F%A5%E8%A9%A2/qryseclno.aspx" width="90%" height="800" frameborder="0" scrolling="no" align="bottom"></iframe>*@
        <h5>系統已封存下線</h5>
    </div>
}

