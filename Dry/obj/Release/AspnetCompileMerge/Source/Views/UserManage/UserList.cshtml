@model AERC.Models.ViewModel.AdminView
@Styles.Render("~/jqgrid/css")
@Scripts.Render("~/bundles/jqueryjqgrid")

<style>
    #div_DataView .modal-body {
        max-height: 800px;
    }
</style>

<div id="User">
    <table id="UserTable"></table>
    <div id="UserPage"></div>
</div>
<div id="div_DataView" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="DataViewLabel" aria-hidden="true">
    <div class="modal-header">
        <h3 id="DataViewLabel"></h3>
    </div>
    <div class="modal-body">
        <iframe id="dataview" style="width:450px;height:500px;"></iframe>
    </div>
    <div class="modal-footer">
        <input type="button" value="關閉" class="btn" data-dismiss="modal" />
    </div>
</div>
<style type="text/css">
    .altClass {
        background: lightYellow;
        color: red;
    }
</style>

<script src="~/Scripts/_UserList.js"></script>