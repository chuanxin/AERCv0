@{
    ViewBag.Title = "推廣管路灌溉設施管理資訊系統";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>公告資訊</h2>
<div class="content">
    <div class="content_item">
        <div align="center"><h5>@ViewBag.QryYear 年度目前預算書編製情形</h5> </div>
        @model IEnumerable<Dry.Models.ViewModel.StatisticCoaView>
        <table class="dashTable">            
                   <tr class="odd">
                        <td>執行單位</td>
                        <td>預定執行面積(公頃)(a)</td>
                        <td>預定執行預算(元)(b)</td>
                        <td>已編預算戶數(d)</td>
                        <td>已編預算面積(公頃)(d)</td>
                        <td>已編列補助款(元)(e)</td>
                        <td>已驗收戶數(f)</td>
                        <td>已驗收面積(公頃)(g)</td>
                        <td>已驗收金額(元)(h)</td>
                        <td>計畫執行率%(i)=(h)/(f)</td>

                    </tr>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(o => item.IaName)</td>
                            <td class="number_right">@Html.DisplayFor(o => item.RsvFarmArea)</td>
                            <td class="number_right"> @Html.DisplayFor(o => item.RsvBudget)</td>
                            <td class="number_right"> @Html.DisplayFor(o => item.BudgetFarmer)</td>
                            <td class="number_right"> @Html.DisplayFor(o => item.BudgetFarmArea)</td>
                            <td class="number_right"> @Html.DisplayFor(o => item.BudgetMoney)</td>
                            <td class="number_right"> @Html.DisplayFor(o => item.CompleteFarmer)</td>
                            <td class="number_right"> @Html.DisplayFor(o => item.CompleteFarmArea)</td>
                            <td class="number_right"> @Html.DisplayFor(o => item.CompleteBugdetMoney)</td>
                            @if (item.BudgetMoney > 0)
                            {
                                var aa = Math.Round((((double)item.CompleteBugdetMoney / item.BudgetMoney) * 100d), 2);
                                <td class="number_right"> @aa %</td>
                            }
                            else
                            {
                                <td class="number_right"> 0 </td>
                            }

                        </tr>
                    }
                    <tr>
                        <td>合計</td>
                        @{ 
                            Dry.Models.ViewModel.StatisticCoaView total = new Dry.Models.ViewModel.StatisticCoaView();
                            total.BudgetFarmer = Model.Sum(o => o.BudgetFarmer);
                            total.BudgetFarmArea = Model.Sum(o => o.BudgetFarmArea);
                            total.BudgetMoney = Model.Sum(o => o.BudgetMoney);
                            total.CompleteFarmer = Model.Sum(o => o.CompleteFarmer);
                            total.CompleteFarmArea = Model.Sum(o => o.CompleteFarmArea);
                            total.CompleteBugdetMoney = Model.Sum(o => o.CompleteBugdetMoney);
                            total.RsvFarmArea = Model.Sum(o => o.RsvFarmArea);
                            total.RsvBudget = Model.Sum(o => o.RsvBudget);
                        }
                        <td class="number_right"> @Html.DisplayFor(o => total.RsvFarmArea)</td>
                        <td class="number_right"> @Html.DisplayFor(o => total.RsvBudget)</td>
                        <td class="number_right"> @Html.DisplayFor(o => total.BudgetFarmer)</td>
                        <td class="number_right"> @Html.DisplayFor(o => total.BudgetFarmArea)</td>
                        <td class="number_right"> @Html.DisplayFor(o => total.BudgetMoney)</td>
                        <td class="number_right"> @Html.DisplayFor(o => total.CompleteFarmer)</td>
                        <td class="number_right"> @Html.DisplayFor(o => total.CompleteFarmArea)</td>
                        <td class="number_right"> @Html.DisplayFor(o => total.CompleteBugdetMoney)</td>
                        @if (total.BudgetMoney > 0)
                        {
                            var totalexc = Math.Round((((double)total.CompleteBugdetMoney / total.BudgetMoney) * 100d), 2);
                            <td class="number_right"> @totalexc %</td>
                        }
                        else
                        {
                            <td class="number_right"> 0 </td>
                        }

                    </tr>
                </table>
        <div id="download">
            @using (Html.BeginForm("DownloadIaFees", "Home", FormMethod.Post, new { @class = "from-inline"}))
            {
                @Html.DropDownList("ApplyYear", (IEnumerable<SelectListItem>)ViewBag.ApplyYearDDL, new { style = "width: 100px;" })
                <button id="AllUnitData" type="submit" class="btn btn-info" title="匯出">
                <img src="~/Content/images/ms_excel.ico" style="width:65px" />
                <br />
                各會經費統計表
                </button>                
            }
        </div>
                <br />
                <table width="100%" align="center" class="dashTable">
                    <thead><tr><th colspan="4">推廣管路灌溉設施管理資訊系統公佈欄</th></tr></thead>
                    <tr>
                        <td colspan="2">

                            本系統的維運與聯繫工作由本中心同仁辦理，如有任何需要協助或解答疑問之處，請以下列聯絡方式告知，謝謝！

                        </td>
                    </tr>

                    <tr>

                        <td width="74%" align="right">
                            <div align="right">
                                聯絡人姓名：<br />
                                聯絡人電話：<br />
                                聯絡人電子信箱：
                            </div>
                        </td>
                        <td width="26%">
                            資訊組 劉時偉  助理研究員<br>
                            03-4521314  轉219<br>
                            alex@aerc.org.tw
                        </td>
                    </tr>
                </table>
</div>
</div>
