@model Dry.Models.ViewModel.FarmerSysView
<script src="~/Scripts/jquery.textchange.min.js"></script>
@Scripts.Render("~/bundles/jqueryjqgrid")
@Styles.Render("~/jqgrid/css")
@Scripts.Render("~/jquery.validate")
<form id="form_FarmerSys">
    <table id="PipingInfoTabl" border="1" class="dashTable" style="width:100%;">
        <thead>
            <tr>
                <th colspan="8">田間管路系統資料</th>
            </tr>
        </thead>
        <tr>
            <td class="td_style">
                補助來源
            </td>
            <td colspan="3">
                <div class="control-group">
                    <div class="controls">
                        @Html.DropDownListFor(model => model.ddl_FarmerSysUnit, (IEnumerable<SelectListItem>)Model.UnitDDL, new { style = "width: 150px;" })
                        @Html.ValidationMessageFor(model => model.ddl_FarmerSysUnit, null, new { @class = "help-inline" })
                    </div>
                </div>
            </td>
            <td class="td_style">
                坵塊形狀 :
            </td>
            <td colspan="2">
                @*@Html.TextBoxFor(model => model.Block, new { @Value = "100x100", style = "width: 100px;", @readonly = true })
                @Html.ValidationMessageFor(model => model.Block, null, new { @class = "help-inline" })*@
                @Html.HiddenFor(model=>model.BuildArea)
                <div class="control-group">
                    <div class="controls">
                        長
                        @Html.TextBoxFor(model => model.Length, new { style = "width: 50px;" })
                        x
                        寬
                        @Html.TextBoxFor(model => model.width, new { style = "width: 50px;", @readonly = true })
                        @Html.ValidationMessageFor(model => model.Block, null, new { @class = "help-inline" })
                        <br />
                        施設面積：@Html.TextBoxFor(model => model.BuildArea, new { style = "width: 50px;", @readonly = true }) m²
                    </div>
                </div>
            </td>
        </tr>
        <tr> 
            <td class="td_style" rowspan="2">田間主管1</td>
            <td class="td_style">長度:</td>
            <td colspan="2">
                <div class="control-group">
                    <div class="controls">@*L1Len可以被jqruy找到？？，無id???*@
                        @Html.TextBoxFor(model => model.L1Len, new { style = "width: 60px;" }) 公尺
                        @Html.ValidationMessageFor(model => model.L1Len, null, new { @class = "help-inline" })
                    </div>
                </div>
            </td>
            <td class="td_style">單價:</td>
            <td>
                <div class="control-group">
                    <div class="controls">
                        <div class="repo-dropdown-menu">
                            @*@Html.TextBoxFor(model => model.L1Mat, null, new { id = "L1Mat_search", @class = "typeahead", placeholder = "請輸入物料名稱 or 物料代碼", style = "width: 100px;" })*@
                            @*@Html.DropDownListFor(model => model.L1Mat, (IEnumerable<SelectListItem>)Model.pipDDL, new { style = "width: 180px;" })*@
                            @Html.TextBoxFor(model => model.L1Price, new { style="width: 60px;"})
                            @Html.ValidationMessageFor(model => model.L1Price, null, new { @class = "help-inline" })
                        </div>
                    </div>
                </div>
            </td>
            <td class="td_style" rowspan="2">數量: </td>
            <td>
                <div class="control-group">
                    <div class="controls">
                        @Html.TextBoxFor(model => model.L1MatAmt, new { style = "width: 60px;" })
                        @Html.ValidationMessageFor(model => model.L1MatAmt, null, new { @class = "help-inline" })
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="td_style">
                材質:
            </td>
            <td colspan="2">
                @Html.DropDownListFor(model => model.L1Mat, (IEnumerable<SelectListItem>)Model.L1QualityDDL, new { style = "width: 100px;" })
                @*@Html.DropDownList("L1Quality", (IEnumerable<SelectListItem>)Model.L1QualityDDL, new { style = "width: 100px;" })*@
            </td>
            <td class="td_style">
                規格:
            </td>
            <td>
                @Html.DropDownListFor(model => model.L1Spec, (IEnumerable<SelectListItem>)Model.L1SpecDDL, new { style = "width: 100px;" })
                @*@Html.DropDownList("L1Spec", (IEnumerable<SelectListItem>)Model.L1SpecDDL, new { style = "width: 100px;" })*@
            </td>
            <td colspan="2"></td>
        </tr>
        <tr>
            <td class="td_style" rowspan="2">田間主管2</td>
            <td class="td_style">長度:</td>
            <td colspan="2">
                <div class="control-group">
                    <div class="controls">
                        @Html.TextBoxFor(model => model.L2Len, new { style = "width: 60px;" }) 公尺
                        @Html.ValidationMessageFor(model => model.L2Len, null, new { @class = "help-inline" })
                    </div>
                </div>
            </td>
            <td class="td_style">單價:</td>
            <td>
                <div class="control-group">
                    <div class="controls">
                        <div class="repo-dropdown-menu">
                            @*@Html.DropDownListFor(model => model.L2Mat, (IEnumerable<SelectListItem>)Model.pipDDL, new { style = "width: 180px;" })*@
                            @*@Html.TextBoxFor(model => model.L2Mat, null, new { @id = "L2Mat_search", @class = "typeahead", @placeholder = "請輸入物料名稱 or 物料代碼", style = "width: 100px;" })*@
                            @Html.TextBoxFor(model => model.L2Price, new { style="width: 60px;"})
                            @Html.ValidationMessageFor(model => model.L2Price, null, new { @class = "help-inline" })
                        </div>
                    </div>
                </div>
            </td>
            <td class="td_style" rowspan="2">數量:</td>
            <td>
                <div class="control-group">
                    <div class="controls">
                        @Html.TextBoxFor(model => model.L2MatAmt, new { style = "width: 60px;" })
                        @Html.ValidationMessageFor(model => model.L2MatAmt, null, new { @class = "help-inline" })
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="td_style">
                材質:
            </td>
            <td colspan="2">
                @Html.DropDownListFor(model => model.L2Mat, (IEnumerable<SelectListItem>)Model.L2QualityDDL, new { style = "width: 100px;" })
                @*@Html.DropDownList("L2Quality", (IEnumerable<SelectListItem>)Model.L2QualityDDL, new { style = "width: 100px;" })*@
            </td>
            <td class="td_style">
                規格:
            </td>
            <td>
                @Html.DropDownListFor(model => model.L2Spec, (IEnumerable<SelectListItem>)Model.L2SpecDDL, new { style = "width: 100px;" })
                @*@Html.DropDownList("L2Spec", (IEnumerable<SelectListItem>)Model.L2SpecDDL, new { style = "width: 100px;" })*@
            </td>
            <td colspan="2"></td>
        </tr>
        <tr>@* 選擇灌溉型式會聯動，先從這瞭解 *@
            <td class="td_style">灌溉型式: </td> 
            <td colspan="3">
                <div class="control-group">
                    <div class="controls">
                        <div>@Html.DropDownList("ddl_EndType", (IEnumerable<SelectListItem>)Model.EndTypeDDL, new { style = "width: 150px;" })</div>
                        <div>@Html.DropDownList("ddl_Drop", (IEnumerable<SelectListItem>)Model.DropDDL, new { style="width: 150px;"})</div>
                        <div>@Html.DropDownList("ddl_Sprinkler", (IEnumerable<SelectListItem>)Model.SprayDDL, new { style = "width: 150px;" })</div>
                        <div>
                            <select id="ddl_Perforated">
                                <option value="1">單向</option>
                                <option value="2">雙向</option>
                            </select>
                        </div>
                    </div>
                </div>
            </td>
            <td class="td_style">設施型式: </td>
            <td>
                <div id="div_FacTypeTrue" class="control-group">
                    <div class="controls">
                        @Html.DropDownList("ddl_FacType", (IEnumerable<SelectListItem>)Model.FacTypeDDL, new { style = "width: 150px;" })
                    </div>
                </div>
                <div id="div_FacTypeFalse" style="display:none;">
                    無
                </div>
            </td>
            <td class="td_style">灌溉水源: </td>
            <td>
                @Html.DropDownList("ddl_WtaerSrc", (IEnumerable<SelectListItem>)Model.WaterSrcDDL, new { style = "width: 100px;" })
            </td>

        </tr>
        <tr>
            <td class="td_style" rowspan="2">支管</td>
            <td class="td_style">材質:</td>
            <td colspan="2">
                <div id="div_BranchPipeMaterialTrue" class="control-group">
                    <div class="controls">
                        @Html.DropDownListFor(model => model.BranchPipeMaterial, (IEnumerable<SelectListItem>)Model.BranchPipeMaterialDDL, new { style = "width: 100px;" })
                    </div>
                </div>
                <div id="div_BranchPipeMaterialFalse" style="display:none;">
                    無
                </div>
            </td>
            <td class="td_style">行距(SL):</td>
            <td>
                <div class="control-group">
                    <div class="controls">
                        @Html.TextBoxFor(model => model.SL, new { style = "width: 100px;" }) 公尺
                        @Html.ValidationMessageFor(model => model.SL, null, new { @class = "help-inline" })
                    </div>
                </div>
            </td>
            <td rowspan="2" class="td_style">
                變徑:
            </td>
            <td rowspan="2">
                @Html.DropDownListFor(model => model.Adjustable, (IEnumerable<SelectListItem>)Model.BranchPipeSpecDDL, new { style = "width: 100px;" })
            </td>
            
        </tr>
        <tr>
            <td class="td_style">規格:</td>
            <td colspan="2">
                <div id="div_BranchPipeSpecTrue" class="control-group">
                    <div class="controls">
                        @Html.DropDownListFor(model => model.BranchPipeSpec, (IEnumerable<SelectListItem>)Model.BranchPipeSpecDDL, new { style = "width: 100px;" })
                    </div>
                </div>
                <div id="div_BranchPipeSpecFalse" style="display:none;">
                    無
                </div>
            </td>
            <td class="td_style">間距(SS):</td>
            <td>
                <div id="div_SSTrue" class="control-group">
                    @Html.TextBoxFor(model => model.SS, new { style = "width: 100px;" }) 公尺
                </div>
                <div id="div_SSFalse" style="display:none;">
                    無
                </div>
            </td>
        </tr>
        <tr>
            <td class="td_style" rowspan="2">末端設施</td>
            
            <td class="td_style">規格:</td>
            <td>
                @Html.DropDownListFor(model => model.NozzleSpec, (IEnumerable<SelectListItem>)Model.NozzleSpecDDL, new { style = "width: 100px;" })
                @*@Html.DropDownList("NozzleSpec", (IEnumerable<SelectListItem>)Model.NozzleSpecDDL, new { style = "width: 100px;" })*@
            </td>
            <td class="td_style" rowspan="2">豎管</td>
            <td class="td_style">
                高度:
            </td>
            <td>
                <div id="div_PipeHeightTrue" class="control-group">
                    <div class="controls">
                        @Html.TextBoxFor(model => model.StdpipeHei, new { style = "width: 100px;" }) 公尺
                        @Html.ValidationMessageFor(model => model.StdpipeHei, null, new { @class = "help-inline" })
                    </div>
                </div>
                <div id="div_PipeHeightFalse" style="display:none;">
                    無
                </div>
            </td>
        </tr>
        <tr>
            <td class="td_style">材料:</td>
            <td>
                @Html.DropDownListFor(model => model.NozzleType, (IEnumerable<SelectListItem>)Model.NozzleMaterialDDL, new { style = "width: 100px;" })
                @*@Html.DropDownList("NozzleType", (IEnumerable<SelectListItem>)Model.NozzleMaterialDDL, new { style = "width: 100px;" })*@
            </td>
            <td class="td_style">材質:</td>
            <td>
                <div id="div_PipeMaterialTrue" class="control-group">
                    <div class="controls">
                        @Html.DropDownListFor(model => model.StdpipeMat, (IEnumerable<SelectListItem>)Model.StdpipeMaterialDDL, new { style = "width: 100px;" })
                        @*@Html.DropDownList("StdpipeMaterial", (IEnumerable<SelectListItem>)Model.StdpipeMaterialDDL, new { style = "width: 100px;" })*@
                    </div>
                </div>
                <div id="div_PipeMaterialFalse" style="display:none;">
                    無
                </div>
            </td>
            <td class="td_style">規格:</td>
            <td>
                <div id="div_PipeSpecTrue" class="control-group">
                    <div class="controls">
                        @Html.DropDownList("StdpipeSpec", (IEnumerable<SelectListItem>)Model.StdpipeSpecDDL, new { style = "width: 100px;" })
                    </div>
                </div>
                <div id="div_PipeSpecFalse" style="display:none;">
                    無
                </div>
            </td>
        </tr>
    </table>
