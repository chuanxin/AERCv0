                <table id="MatTabl_MainPipe" border="1" style="width:100%;" class="dashTable">
                    <thead>
                        <tr>
                            <th style="text-align:center;">項目</th>
                            <th style="text-align:center;">名稱</th>
                            <th style="text-align:center;">類別</th>
                            <th style="text-align: center; display: none;">材質</th>
                            <th style="text-align:center;">規格</th>
                            <th style="text-align:center;">單位</th>
                            <th style="text-align:center;">敘述</th>
                            <th style="text-align: center; width: 60px;">單價</th>
                            <th style="text-align:center; width:60px;">數量</th>
                            <th style="text-align:center; width: 70px;">總價</th>
                            <th style="text-align: center; width: 70px;">排序</th>
                            <th style="text-align:center; width:50px;">刪除</th>
                        </tr>
                    </thead>
                    @if (Model.Mat != null)
                    {
                        foreach(var groupitem in Model.Mat)
                        {
                            <tr>
                                <td colspan="12">@groupitem.GroupName</td>
                            </tr>
                            foreach (var item in groupitem.List)
                            {
                                string itemid = "tr_p_" + item.MatGroup + "_" + item.POMNo;
                                <tr id="@itemid">
                                    <td id="pomno" style="display:none;">@item.POMNo</td>
                                    <td style="display:none;">@item.MatGroup</td>
                                    <td style="display:none;">@item.MatOrder</td>
                                    <td>@item.MatOrderCNS</td>
                                    <td id="matname" style="text-align:center;">@item.MName</td>
                                    <td id="modul" style="text-align:center;">@item.ModuleCNS</td>
                                    <td id="mattype" style="text-align: center; display: none;"></td>
                                    <td id="spec" style="text-align:center;">@item.Spec1 @item.Spec2 @item.Spec3</td>
                                    <td id="itemunit" style="text-align:center;">@item.ItemUnit</td>
                                    <td id="desp">@item.Note</td>
                                    <td id="price" style="text-align:center;"><input id="txt_price" type="text" style="width:45px" value="@item.Price" onchange="$('#@itemid').CalTotal(); return false;"></td>
                                    <td id="amt" style="text-align:center;"><input id="txt_amt" type="text" style="width:45px" onchange="$('#@itemid').CalTotal(); return false;" value="@item.Amount"></td>
                                    <td id="total" style="text-align:center;"><input id="txt_totalprice" type="text" style="width:60px" value="@item.TotalPrice"></td>
                                    <td>
                                        <div class="row-fluid">
                                            <div class="span6">
                                                <input type="button" onclick="javascript:$('#@itemid').UpMatOrder();return false;" value="↑" style="width:30px; padding-right: 10;" class="btn" />
                                            </div>
                                            <div class="span6">
                                                <input type="button" onclick="javascript:$('#@itemid').DownMatOrder();return false;" value="↓" style="width:30px;" class="btn" />
                                            </div>
                                        </div>
                                    </td>
                                    <td align="center">
                                        <a href="#" onclick="$('#@itemid').DelMat();return false;" class="btn btn-danger" style="width:30px;">刪除</a>
                                    </td>
                                </tr>
                            }
                        }
                        
                    }
                </table>
                <div class="row-fluid">
                    <div class="span7">
                        <div id="div_Group" style="background-color: rgb(255,2550,204); border-style: solid; border-width: 1px; display:none; ">
                            <div class="row-fluid">
                                <h3 id="ProxyLabel">選擇物料群組</h3>
                            </div>
                            <div class="row-fluid">
                                <div class="row-fluid">
                                    @Html.DropDownList("ddl_Group", (IEnumerable<SelectListItem>)Model.GroupDDL, new { style = "width: 150px;" })
                                </div>
                            </div>
                            <div class="row-fluid">
                                <input type="hidden" id="hiddn_pomno" />
                                <table class="table-bordered" width="500">
                                    <tr>
                                        <td rowspan="2" colspan="2">
                                            <h2><strong><span id="span_matname"></span></strong></h2>
                                        </td>
                                        <td>
                                            單位：
                                            <span id="span_itemunit"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            單價：
                                            <span id="span_price"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            材質：
                                            <span id="span_mattype"></span>
                                        </td>
                                        <td>
                                            規格：
                                            <span id="span_matspec"></span>
                                        </td>
                                        <td colspan="2">
                                            模組名稱：
                                            <span id="span_modulename"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4">
                                            描述：
                                            <span id="span_note"></span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            @*送出銨鈕的id btn_send對應jqury新增物料使用*@
                            <div class="row-fluid text-right" style="padding-bottom:5px; padding-right:5px; border-top-width:2px;border-top-style:solid;">
                                <input id="btn_send" type="button" value="送出" class="btn" />
                                <input type="button" value="關閉" class="btn" onclick="$('#div_Group').fadeOut();" />
                            </div>
                        </div>
                    </div>
                    <div class="span5 text-right">
                        總計
                        <input id="txt_Mat_Total" type="text" class="input-small" value="0" />
                    </div>
                </div>
            </td>
        </tr>
        <tr id="add_new_mat" style="display:none;">
            <td class="td_style">新增物料</td>
            <td colspan="9">
                <div class="repo-dropdown-menu">
                    <input id="Mat_Search" class="typeahead" type="text" placeholder="請輸入物料名稱 or 物料代碼">
                </div>
            </td>
        </tr>
    </table>
    
    <table id="MatList"></table>
    <div id="MatFooter"></div>
    <table border="1" class="dashTable" align="center" style="width:80%;">
        <tr>
            <td colspan="6">
                @{
                    if (ViewBag.Gold == true)
                    {
                        //Html.RenderPartial("../FundingTableGold");
                        Html.RenderPartial("../FundingTable");
                    }
                    else
                    {
                        Html.RenderPartial("../FundingTable");
                    }
}
                
                <script type="text/javascript">
                    $(function () {
                        $('#tdCaseM').text(@Model.CaseMoney);
                    });
                </script>
            </td>
        </tr>
    </table>
    @if(Model.Step < 8)
    {
        if(!Model.IsModify)
        {
            <input id="btn_SaveFarmerSys" type="button" value="送出，前往下個步驟" class="btn" />
        <input id="btn_PassFarmerSys" type="button" value="略過>>" class="btn" />
        }
        else
        {
            <input id="btn_ModifyFarmerSys" type="button" value="修改田間管路" class="btn" />
        }
    }
</form>

