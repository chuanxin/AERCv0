@{
    ViewBag.Title = "管路灌溉及時資訊下載";
    
}
<div class="text-center">
    <h2 class="text-info text-center">@ViewBag.Title</h2>
</div>
<div class="container-fluid">
    <div class="row-fluid">
        <div class="span4 text-center">
            <h4 class="text-warning">年度原民鄉鎮補助情形</h4>
            <div class="row-fluid" align="center">
                @using (Html.BeginForm("DownLoadIndiTown", "HOME"))
                {<button id="BtnExcel" type="submit" class="btn" title="下載">
                        <img src="~/Content/images/adobe_pdf.ico" style="width:40px" />
                        <br />
                        <font size="2">下載</font>
                    </button>
                }
            </div>
        </div>
        <div class="span4 text-center">
            <h4 class="text-warning">年度原民鄉補助管理處辦理情形</h4>
            <div class="row-fluid" aling="center">
                @using (Html.BeginForm("DownLoadIndiIa", "HOME"))
                {
                    <button id="BtnExcel" type="submit" class="btn" title="下載">
                        <img src="~/Content/images/adobe_pdf.ico" style="width:40px" />
                        <br />
                        <font size="2">下載</font>
                    </button>
                }
            </div>

        </div>
        <div class="span4 text-center">
            <h4 class="text-warning">年度管理處辦理情形</h4>
            <div class="row-fluid" aling="center">
                @using (Html.BeginForm("DownLoadIaKPI", "HOME"))
                {
                    <button id="BtnExcel" type="submit" class="btn" title="下載">
                        <img src="~/Content/images/adobe_pdf.ico" style="width:40px" />
                        <br />
                        <font size="2">下載</font>
                    </button>
                }
            </div>
        </div>
    </div>
</div>


