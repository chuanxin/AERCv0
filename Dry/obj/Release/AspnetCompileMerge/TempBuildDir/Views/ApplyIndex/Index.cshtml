@{
    ViewBag.Title = "推廣管路灌溉設施管理資訊系統";
    @Scripts.Render("~/bundles/jqueryjqgrid")
    @Styles.Render("~/jqgrid/css")
    @model Dry.Models.ViewModel.ApplyIndexView
}

<script type="text/javascript">
    //啟動「編輯/審視」的blockUI
    function blockui() {
        $.EnableBlockUI('');
    }

    
    $(function () {
        //判別若為彰化、雲林以外的會，則不顯示黃金廊道欄位(於jqgrid中的"Gold"欄位)
        var notLiu = true;
        if ('@Session["UnitID"].ToString()' == '9' || '@Session["UnitID"].ToString()' == '10')
            notLiu = false;
        var status = false;
        if ('@Session["Status"]' == 'True')
            status = true;
        //alert(status);
        //判別是否為瑠公
        var isLiu = false;
        if ('@Session["UnitID"].ToString()' == '17')
            //isLiu = true;
            isLiu = false;
        //若單位為農工中心、農委會或聯合會，則顯示承辦單位
        DisplayUnit = false;
        if ('@Session["UnitID"].ToString()' != '99' && '@Session["UnitID"].ToString()' != '0' && '@Session["UnitID"].ToString()' != '20')
            DisplayUnit = true;
        //----------------------------------------------------------
        var applyYear = $('#ddl_ApplyIndexYear option:selected').val();
        //資料總覽(jqGrid)
        var grid = $('#grid');
        grid.jqGrid({
            url: '@Url.Action("GetFarmerData", "ApplyIndex")' + '?ApplyYear=' + applyYear,
            datatype: 'json',
            jsonReader: {
                repeatitems: false,
                id: 'FId'
            },
            mtype: 'GET',
            colNames: ['申請年度', '承辦單位', '水利會案號', '申請人姓名', '末端型式', '施作面積m²', '黃金廊道', '案件狀態', '審視/編輯', '產出報表', ''],
            colModel: [
                { name: 'ApplyYear', index: 'ApplyYear', width: 25, align: 'center',  search: false },
                { name: 'ApplyUnit', width: 40, align: 'center', search: false, hidden: DisplayUnit },
                { name: 'IANum', width: 40, align: 'center', search: false },
                { name: 'Name', width: 40, align: 'center', search: false },
                { name: 'CatalogCNS', width: 40, align: 'center', search: false },
                { name: 'buildarea', width: 40, align: 'center', search: false },
                { name: 'Gold', width: 25, align: 'center', search: false, hidden: notLiu },
                { name: 'Status', width: 50, align: 'center', search: false },
                { name: 'EventNo', index: 'EventNo', width: 30, search: false, editable: false, viewable: false, formatter: OpenData },
                { name: 'EventNo', width: 30, search: false, editable: false, viewable: false, formatter: Report, hidden: !isLiu },
                { name: 'EventNo', width: 20, search: false, editable: false, viewable: false, formatter: DelData, hidden: !status }
            ],
            pager: '#pager',
            autowidth: true,
            //width: 800,
            height: 'auto',
            rowNum: 20, //預設行數 9+
            rowList: [5, 10, 20, 50, 100], //行數選單
            //sortname: 'Name',
            //sortorder: "desc",
            viewrecords: true,
            rownumbers: true,
            caption: '旱作灌溉申請案件', //表格title
            loadComplete: function (ids) {
                $('.ui-pg-table table input[type=text]').css('width', '20').css('height', '20'); //設定頁數的textbox寬度及高度
                $('.ui-pg-table table select').css('width', '60').css('height', '30'); //設定筆數的DropDownList
                $('#pager_center').css('width', '400'); //設定頁數區塊的寬度
                $('#pager_left').css('width', '250'); //設定功能按鈕的區塊寬度
            }
        });
        grid.navGrid('#pager',
            { edit: false, add: false, del: false, search: false },
            {}, /*edit*/
            {}, /*add*/
            {}, /*delete*/
            {}, /*search*/
            {} /*view*/);

        $('#ddl_ApplyIndexYear').change(function () {
            applyYear = $('#ddl_ApplyIndexYear option:selected').val();
            $('#grid').setGridParam({ url: '@Url.Action("GetFarmerData", "ApplyIndex")' + '?ApplyYear=' + applyYear }).trigger("reloadGrid"); //重新載入jqGrid
        })

        //查詢
        $("#btn_ApplyIndexQuerySubmit").click(function () {
            var searchFiler = $("#txt_ApplyIndexQueryString").val();
            var grid = $("#grid");
            if (searchFiler.length === 0) {
                grid[0].p.search = false;
                $.extend(grid[0].p.postData, { searchString: "" });
            } else {
                grid[0].p.search = true;
                $.extend(grid[0].p.postData, { searchString: searchFiler });
            }
            grid.trigger("reloadGrid", [{ page: 1, current: true }]); //重新載入jqGrid
            return false;
        });

        function OpenData(cellvalue, options, rowObject) {
            return '<a href="' + '@Url.Action("Redirect", "ApplyIndex")' + '?eventno=' + cellvalue + '" class="btn" onclick="blockui();">編輯/審視</a>';
        }
        //產出報表
        function Report(cellvalue, options, rowObject) {
            return '<a href="' + '@Url.Action("Report", "ApplyIndex")' + '?eventno=' + cellvalue + '" class="btn">產出</a>';
        }
        //刪除
        function DelData(cellvalue, options, rowObject) {
            return '<a onclick="Del(' + cellvalue +',\''+options.rowId +'\')" class="btn">刪除</a>';
        }
        $("#DelMenu").dialog({
            autoOpen: false,
            modal: true,
            close: function () {
                //var seldata = ($("#delrsn").children("option").filter(":selected").val());
                //var seldata = ($("#delrsn option:checked").val());
                //var rowid = $("#rowid").val();
                //alert( `${seldata} ${rowid}`);
            }
        });
        $("#delbtn").click(function () {
            var seldata = ($("#delrsn option:checked").val());
            var rowid = $("#rowid").val();
            //alert(`${seldata} ${rowid}`);
            DelExe(rowid, seldata);
            $("#DelMenu").dialog("close");
        });
        $("#cnlbtn").click(function () {
            $("#DelMenu").dialog("close");
        });

    });
    function Del(EventNo,rowObj) {
        var ids = $("#grid").jqGrid('getDataIDs');
        var msg = "";

        //for (var i = 0; i < ids.length; i++) {
        //    var rowId = ids[i];
        //    var rowData = $("#grid").jqGrid('getRowData', rowId);
        //    if (rowId == rowObj) {
        //        msg = "確定刪除編號:" + rowData.IANum + rowData.Name + "案件嗎？";
        //        break;
        //    }
        //}
        //msg = "確定刪除編號:" + rowObj + "案件嗎？";
        var rowData = $("#grid").jqGrid('getRowData', rowObj);
        $("#rowid").val(EventNo);
        msg = "確定刪除編號:" + rowData.IANum + rowData.Name + "案件嗎？";
        $("#delmessage").text(msg);
        var rsn = $("#DelMenu").dialog("open");
        //alert(rsn);
        @*if (!confirm(msg))
            return false;
        $.getJSON('@Url.Action("DelData", "ApplyIndex")' + '?EventNo=' + EventNo, function (data) {
            if (data == 'Success') {
                $("#grid").trigger("reloadGrid", [{ page: 1, current: true }]); //重新載入jqGrid
            }
        })*@;
    }
    function DelExe(EventNo,rsn) {
        $.getJSON('@Url.Action("DelData", "ApplyIndex")' + `?EventNo=${EventNo}&rsn=${rsn}`  , function (data) {
            if (data == 'Success') {
                $("#grid").trigger("reloadGrid", [{ page: 1, current: true }]); //重新載入jqGrid
            }
        });
    }
</script>

<h2>農戶申請業務(案件總覽)</h2>
<div class="content">
    @*@Html.ActionLink("建立新的案件", "Index", "Farmer", null, new { @class = "btn" })*@
    @{Html.BeginForm("Redirect", "ApplyIndex", FormMethod.Post);}
    <input id="btn_NewCase" type="submit" value="建立新的案件" class="btn" />
    @{Html.EndForm();}
    @*@Html.ActionLink("建立新的案件", "Index", "ApplyStep", null, new { @class = "btn" })*@
    <div class="form-inline">
        @Html.DropDownList("ddl_ApplyIndexYear", (IEnumerable<SelectListItem>)Model.ApplyYearDDL, new { style = "width: 100px;" })
        <input id="txt_ApplyIndexQueryString" type="text" class="input-medium" placeholder="輸入案號或姓名" />
        <input id="btn_ApplyIndexQuerySubmit" type="button" value="查詢" class="btn" />
    </div>

    <div id="div_Content">
        <table id="grid"></table>
        <div id="pager"></div>
    </div>
</div>
<div id="DelMenu" title="刪除確認" style="display:none">
    <label id="delmessage"></label>
    <select id="delrsn">
        <option value="測試資料">測試資料</option>
        <option value="資格不符">資格不符</option>
        <option value="驗收未過">驗收未過</option>
        <option value="撤回申請">撤回申請</option>
        <option value="資料錯誤">資料錯誤</option>
        <option value="配合農時">配合農時</option>
        <option value="其他">其他</option>
    </select>
    <button class="btn btn-danger" id="delbtn">確認</button>
    <button class="btn btn-primary" id="cnlbtn">取消</button>
    <input type="hidden" id="rowid" />
</div>