@{
    ViewBag.Title = "推廣管路灌溉設施管理資訊系統";
        
    @model Dry.Models.ViewModel.ApplyIndexView
}
@section css{
    <link href="~/Content/jquery-ui.css" rel="stylesheet" />
    <link href="~/Content/DataTables/css/jquery.dataTables.css" rel="stylesheet" />

    }


<h2>初審意見表</h2>

<div class="form-inline">
    @Html.DropDownList("ddl_ApplyIndexYear", (IEnumerable<SelectListItem>)Model.ApplyYearDDL, new { style = "width: 100px;" })
    @*<input id="txt_ApplyIndexQueryString" type="text" class="input-medium" placeholder="輸入案號" />*@
    <input id="btn_ApplyIndexQuerySubmit" type="button" value="查詢" class="btn" />
    <input id="btn_export" type="button" class="btn btn-info" value="匯出表格" />
</div>

<div id="div_Content">
    <table id="grid" class="table table-striped table-bordered" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th style="color:black">勾選</th>
                <th style="color:black">匯出日期</th>
                <th style="color:black">案號</th>
                <th style="color:black">申請年度</th>
                <th style="color:black" width="70">承辦單位</th>
                <th style="color:black">申請人姓名</th>
                <th style="color:black">末端型式</th>
                <th style="color:black">施作面積m²</th>
                <th style="color:black">黃金廊道</th>
                <th style="color:black" width="80">案件狀態</th>
                <th style="color:black">編碼</th>
                <th style="color:black">匯出</th>                
                
            </tr>
        </thead>
        <tbody>
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>
    <div id="pager"></div>
</div>
@section scripts{
<script src="~/Scripts/DataTables/jquery.dataTables.js"></script>
<script>
    ////啟動「編輯/審視」的blockUI
    function blockui() {
        $.EnableBlockUI('');
    }


    $(function () {

        //----------------------------------------------------------
        var applyYear = $('#ddl_ApplyIndexYear option:selected').val();
        //資料總覽(jqGrid)
        var reportIds = new Array();
        //var grid = $('#grid');


        $('#grid').DataTable({
            "columns": [
                {
                    "data": "Export", orderable: true, render: function (data, type, obj, meta)
                    {
                        if (data == true) {

                            return "<input type='checkbox' checked=true >";
                        } else return "<input type='checkbox'>";

                    }
                }, { "data": "匯出日期" }, { "data": "案號" }, { "data": "申請年度", "searchable": false }, { "data": "承辦單位" },
                { "data": "申請人姓名" },{ "data": "末端型式" }, { "data": "施作面積", "searchable": false}, { "data": "黃金廊道" },
                { "data": "案件狀態" }, { "data": "編號", "visible": false, "searchable": false }, {"data": "列印"}],/*
            "columnDefs": [
                {
                    "targets": [2],                    
                    "searchable": false
                },
                {
                "targets": [9],
                "visible": false,
                "searchable": false
            }],*/
            "order": [[2, 'asc']],
            "language":
                        {
                            "processing": "處理中...",
                            "loadingRecords": "載入中...",
                            "lengthMenu": "顯示 _MENU_ 項結果",
                            "zeroRecords": "沒有符合的結果",
                            "info": "顯示第 _START_ 至 _END_ 項結果，共 _TOTAL_ 項",
                            "infoEmpty": "顯示第 0 至 0 項結果，共 0 項",
                            "infoFiltered": "(從 _MAX_ 項結果中過濾)",
                            "infoPostFix": "",
                            "search": "搜尋:",
                            "paginate": {
                                "first": "第一頁",
                                "previous": "上一頁",
                                "next": "下一頁",
                                "last": "最後一頁"
                            },
                            "aria": {
                                "sortAscending": ": 升冪排列",
                                "sortDescending": ": 降冪排列"
                            }
                        },

            deferRender: true
        });


        $("#grid tbody").on("click", "button,input", function () {
            var data = $("#grid").DataTable().row(this.parentElement).data();
            var rowdatas = $("#grid").DataTable().data();
            //alert(this.value);
            //console.log(this);
            if (data["編號"] == "") {
                alert("沒有資料可以編輯");
                return false;
            }
            //要報表
            if (this.checked) {
                //alert("report to " + data["編號"]);
                this.value = true;
                reportIds.push(data["編號"]);
                for (var i = 0; i < rowdatas.length; i++) {
                    if (rowdatas[i].編號 == data["編號"]) {
                        rowdatas[i].Export = true;
                        rowdatas[i].列印 = "是";
                        $("#grid").DataTable().row(i).invalidate().draw(false);
                        break;
                    }
                }


            } else {
                this.value = false;
                for (var i = 0; i < reportIds.length; i++) {
                    if (data["編號"] == reportIds[i]) {
                        reportIds.splice(i, 1);
                        break;
                    }
                }

                for (var i = 0; i < rowdatas.length; i++) {
                    if (rowdatas[i].編號 == data["編號"]) {
                        rowdatas[i].Export = false;
                        rowdatas[i].列印 = "否";
                        $("#grid").DataTable().row(i).invalidate().draw(false);
                        break;
                    }
                }
            }
        });


        //查詢
        $("#btn_ApplyIndexQuerySubmit").click(function () {
            applyYear = $('#ddl_ApplyIndexYear option:selected').val();

            var parms = {"ApplyYear":applyYear};
            //parms.ApplyYear = applyYear;
            var datatable = $("#grid").DataTable();
            blockui();
            $.ajax({
                url: "@Url.Content("~/PreliminaryTrial/GetFarmerDataNew")",
                method: "post",
            data:parms
        })
            .done(function (data) {
                datatable.clear();
                datatable.rows.add(data);
                datatable.draw();
                reportIds = new Array();
                $.DisableBlockUI();
            });

        });

        $("#btn_export").click(function () {
            if (reportIds.length <= 0) {
                alert("沒有選取資料匯出!!");
                return false;
            }
            var parms = { Ids: reportIds };
            blockui();
            $.ajax({
                url: "@Url.Action("ExportDoc","PreliminaryTrial")",
                method: "POST",
                data: { parmsString: JSON.stringify(parms) },
                success: function (data) {
                    //alert(data.FileGuid);
                    $.DisableBlockUI();
                    //window.location = "@Url.Content("~/PreliminaryTrial/DownFile?docids=")" + data.FileGuid;
                    //window.location = "@Url.Content("~/PreliminaryTrial/DownFileXls?docids=")" + data.FileGuid1;
                    window.open("@Url.Content("~/PreliminaryTrial/DownFile?docids=")" + data.FileGuid);
                    window.open("@Url.Content("~/PreliminaryTrial/DownFileXls?docids=")" + data.FileGuid1);

                }
            });

        });

        //first to trigger load data
        $("#btn_ApplyIndexQuerySubmit").trigger("click");
    });



</script>
    }
