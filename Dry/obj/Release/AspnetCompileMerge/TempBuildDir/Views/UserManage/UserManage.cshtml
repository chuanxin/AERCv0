@model AERC.Models.ViewModel.AdminView

@{
    ViewBag.Title = "推廣管路灌溉設施管理資訊系統";
}

@Html.HiddenFor(model => model.UnitId)
@if (TempData["message"] != null)
{
    <script type="text/javascript">
        var message = '@TempData["message"].ToString()';
        alert(message);
    </script>
}
<h2>人員管理</h2>
<div class="content">
    <ul class="nav nav-tabs">
        <li class="active">
            <a href="#UserEdit" data-toggle="tab">編輯個人資料</a>
        </li>
        @{
            if ((bool)Session["Status"])
            {
                <li>
                    <a href="#UserManage" data-toggle="tab">建立使用者資料</a>
                </li>
                <li>
                    <a href="#UserList" data-toggle="tab">使用者資料列表</a>
                </li>
            }
        }

    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="UserEdit">
            @{Html.RenderAction("UserEdit");}
        </div>

        @{
            if ((bool)Session["Status"])
            {
                <div id="UserManage" class="tab-pane">
                    @{Html.EnableClientValidation(true);}
                    @using (Html.BeginForm("UserManage", "UserManage"))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <fieldset>
                            @Html.HiddenFor(model => model.UnitId)
                            <table>
                                <tr>
                                    <td class="td_style">姓名</td>
                                    <td>
                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="td_style">
                                        帳號
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => model.Account, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Account, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="td_style">密碼</td>
                                    <td>
                                        @Html.PasswordFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="td_style">職稱</td>
                                    <td>
                                        @Html.DropDownListFor(model => model.Title_Id, Model.TitleDDL, "--請選擇--", new { style = "width: 150px;" })
                                        @Html.ValidationMessageFor(model => model.Title_Id, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="td_style">組室</td>
                                    <td>
                                        @Html.DropDownListFor(model => model.Organization_Id, Model.OrganDDL, "--請選擇--", new { style = "width: 150px;" })
                                        @Html.ValidationMessageFor(model => model.Organization_Id, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="td_style">電話</td>
                                    <td>
                                        @Html.EditorFor(model => model.Telephone, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Telephone, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="td_style">手機</td>
                                    <td>
                                        @Html.EditorFor(model => model.Mobile, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="td_style">傳真</td>
                                    <td>
                                        @Html.EditorFor(model => model.Fax, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Fax, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="td_style">
                                        <span>承辦</span>
                                        @Html.RadioButtonFor(model => model.Status, "true", new { @class = "statusRadio" })
                                        <span>非承辦</span>
                                        @Html.RadioButtonFor(model => model.Status, "false", new { @class = "statusRadio" })
                                        @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="td_style">
                                        <span>啟用</span>
                                        @Html.RadioButtonFor(model => model.Enabled, "true", new { @class = "statusRadio" })
                                        <span>停用</span>
                                        @Html.RadioButtonFor(model => model.Enabled, "false", new { @class = "statusRadio" })
                                        @Html.ValidationMessageFor(model => model.Enabled, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                            </table>
                        </fieldset>
                        <input id="btnCreate" type="submit" value="建立會員資料" class="btn btn-primary" />
                    }
                </div>
                <div id="UserList" class="tab-pane">
                    @{Html.RenderPartial("UserList");}
                </div>
                        }
        }
    </div>
    </div>



