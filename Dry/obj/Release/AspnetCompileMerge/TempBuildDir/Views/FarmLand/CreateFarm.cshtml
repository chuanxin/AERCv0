                            $('#grid').trigger("reloadGrid", [{ current: true }]); //重新載入jqGrid
                            clearAllTxt();
                            $.DisableBlockUI();
                            $('#btn_EditFarm').after(
                                '<div id="alert_FarmerModifySuccess" class="alert alert-success fade in" style="width:200px;">' +
                                    '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                                    '<strong>更新成功!</strong> 資料已完成修改。' +
                                '</div>'
                                );
                        } else {
                            $.DisableBlockUI();
                            //alert(data)
                            $('#btn_EditFarm').after(
                                '<div id="alert_FarmerModifyFail" class="alert alert-error fade in" style="width:200px;">' +
                                    '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                                    '<strong>更新失敗!</strong> 資料未修改。' + data + "。" +
                                '</div>'
                                );
                        }

                    });
                }

                //alert(FarmObj.Lat);
                //$('#alert_FarmerNoData').hide();
                ExportReport();
                //隱藏編輯按鈕
                //$('#btn_EditFarm').hide();
            }
        }
    }
</script>
