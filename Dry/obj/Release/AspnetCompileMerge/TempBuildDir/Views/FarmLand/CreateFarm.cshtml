    function openMap(js) {
        var form = document.createElement("form");
        form.setAttribute("method", "post");
        form.setAttribute("action", "http://irrggis.aerc.org.tw/AercAPI/AERC/MapAPI");
        form.setAttribute("target", 'IrrgAPI');
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'jsonTxt';
        input.value = js;
        form.appendChild(input);
        document.body.appendChild(form);
        window.open('http://irrggis.aerc.org.tw/AercAPI/AERC/MapAPI', 'IrrgAPI')

        form.submit();
        document.body.removeChild(form);
    }

    //Define custom WMS tiled layer
    @*var SLPLayer = new google.maps.ImageMapType({
        getTileUrl: function (coord, zoom) {
            var proj = Map.getProjection();
            var zfactor = Math.pow(2, zoom);
            // get Long Lat coordinates
            var top = proj.fromPointToLatLng(new google.maps.Point(coord.x * 256 / zfactor, coord.y * 256 / zfactor));
            var bot = proj.fromPointToLatLng(new google.maps.Point((coord.x + 1) * 256 / zfactor, (coord.y + 1) * 256 / zfactor));

            //corrections for the slight shift of the SLP (mapserver)
            var deltaX = 0
            var deltaY = 0;

            //create the Bounding box string
            var bbox = (top.lng() + deltaX) + "," +
                           (bot.lat() + deltaY) + "," +
                           (bot.lng() + deltaX) + "," +
                           (top.lat() + deltaY);
            //base WMS URL
            var url = "http://203.66.14.109:8080/geoserver/Taiwan/wms?";
            url += "REQUEST=GetMap"; //WMS operation
