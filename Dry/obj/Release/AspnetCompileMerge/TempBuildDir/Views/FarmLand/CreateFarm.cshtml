                    console.log(JSON.stringify(FarmObj));
                    FarmObj.FNo = $('#hidn_fno').val();
                    //alert(FarmObj.Corp[0].corpname +","+ FarmObj.Corp[0].corpcode);
                    //alert("edit");
                    $.postJson('@Url.Action("ModifyDataSingle", "FarmLand")', FarmObj, function (data) {
                        //alert("inside");
