    function CacuPleaseHolderArea() {
        var area = parseFloat($('#LandArea').val().length > 0 ? $('#LandArea').val() : 0);
        var par = parseFloat($('#Par').val());
        var chd = parseFloat($('#child').val());
        $('#hasArea').val((area * (chd / par)).toFixed(4));
    }
    function GetEditFarmData(fno) {
        //alert(fno);
        $.getJSON('@Url.Action("SingleFarm", "FarmLand")' + '?fno=' + fno, function (data) {

            $("#form_Farm1 input[id='LandNo']").val(data.LandNo);

            //CityDDL
            $("#FarmCityCode").val(data.CTCode);

            //TownDDL
            if (data.TownCode == undefined) {
                GetTownDDL(data.CTCode);
                $("#FarmTownId").val(data.twCode);
            } else {
                GetTownDDL(data.CTCode);
                $("#FarmTownId").val(data.TownCode);
            }
            //SectionDDL
            if (data.TownCode == undefined) {
                GetSecDDL(data.twCode);
                $("#FarmSection").val(data.SectCode);
            } else {
                GetSecDDL(data.TownCode);
                $("#FarmSection").val(data.SectCode);//$('#Section').prop('selectedIndex', (data.SectCode - 1));
            }
            $('#hidn_fno').val(fno);
            $('#LandType').prop('selectedIndex', (data.TypeCode - 1));
            $('#LandArea').val(data.Area);
            $('#txt_FarmHa').val((parseFloat(data.Area) / 10000).toFixed(4));
            $('#BuildArea').val(data.BArea);
            $('#txt_BuildHa').val((parseFloat(data.BArea) / 10000).toFixed(4));
            $('#Lat').val(data.Lat);
            $('#Long').val(data.Long);
            $('#Outside').prop('checked', data.OutSide);
            $('#IsApplied').prop('checked', data.IsApplied);
            $('#ApplicationStatus').val(data.ApplicationStatus);
            $('#Pcent_Chd').val(data.Pcent_Chd);
            $('#Pcent_Par').val(data.Pcent_Par);

            //corp data
            Remove_corptr();

            var corplist = data.Corp;
            var no = $('td[id=td_cropno]').length;
            for (var item in corplist) {
                no++;
                $('#CropTable').append(
               '<tr id="corpTabltr_' + no + '">' +
                   '<td id="td_cropno" align="center">' + no + '</td>' +
                   '<td id="td_cname" align="center">' + corplist[item].corpname + '</td>' +
                   '<td align="center"><a id="del_link" href="#" onclick="$(\'#corpTabltr_' + no + '\').DelCorp();return false;">刪除</a></td>' +
                   '<input id="hidden_corpcode" type="hidden" value="' + corplist[item].corpcode + '" />' +
               '</tr>');
            }
            if (no == 0) {
                Append_corp_Empty();;
            }

            //hanlder data
            Remove_holdertr();

            var holderlist = data.Holder;
            var no = $('td[id=td_holdno]').length;
            for (var item in holderlist) {
                no++;
                $('#HolderTable').append(
               '<tr id="holdTabltr_' + no + '">' +
                   '<td id="td_holdno" align="center">' + no + '</td>' +
                   '<td id="td_holdname" align="center">' + holderlist[item].name + '</td>' +
                   '<td id="td_holdIDNo" align="center">' + holderlist[item].id + '</td>' +
                   '<td id="td_holdAddr" align="center">' + holderlist[item].addr + '</td>' +
                   '<td id="td_holdPer" align="center">' + holderlist[item].perC + '/' + holderlist[item].perP + '</td>' +
                   '<td id="td_holdArea" align="center">' + holderlist[item].area + '</td>' +
                   '<td align="center"><a id="del_link" href="#" onclick="$(\'#holdTabltr_' + no + '\').DelCorp();return false;">刪除</a></td>' +
               '</tr>');
            }
            if (no == 0) {
                Append_holderEmpty();
            }
        });
    }
    function DelFarmData(fno) {
        if (!confirm('確定刪除？')) {
            return null;
        }
        $.getJSON('@Url.Action("DelSingleData", "FarmLand")' + '?fno=' + fno, function (data) {
            //alert(data);
            if (data == 'Success') {
                $('#grid').trigger("reloadGrid", [{ current: true }]); //重新載入jqGrid
            } else {
                alert(data);
            }
        });
    }
    function AddFarmData(FarmStatus) {
        //alert("addfarm1");
        var check = true;
        var cropAmt = $('td[id=td_cropno]').length;
        //var holdAmt = $('td[id=td_holdno]').length;

        if (cropAmt <= 0) {// || holdAmt <= 0)
            check = false;
            alert("請輸入作物");
        } else {
            check = ChkLandArea();//判斷土地面積是否符合
            //農地基本資料
            //alert("farmbasic");
            if ($("#form_Farm1").validate().form() && check) {
                var FarmObj = new Object();
                FarmObj.MapNo = 0;
                FarmObj.LandNo = $('#LandNo').val(); //目前申請之地號

                FarmObj.CTName = $('#FarmCityCode :selected').text(); //縣市(名稱)
                FarmObj.CTCode = $('#FarmCityCode :selected').val(); //縣市(代碼)

                FarmObj.twName = $('#FarmTownId :selected').text(); //鄉鎮市(名稱)
                FarmObj.twCode = $('#FarmTownId :selected').val(); //鄉鎮市(代碼)

                FarmObj.SectName = $('#FarmSection :selected').text(); //地段(名稱)
                FarmObj.SectCode = $('#FarmSection :selected').val(); //地段(代碼)
                FarmObj.FullName = '';
                //
                FarmObj.TypeName = $("#LandType :selected").text(); //地目(名稱)
                FarmObj.TypeCode = $('#LandType :selected').val(); //地目(代碼)
                //
                FarmObj.Area = $("#LandArea").val(); //農地面積(m²)
                FarmObj.BArea = $("#BuildArea").val(); //施設面積(m²)

                FarmObj.Lat = $("#Lat").val(); //經度
                FarmObj.Long = $("#Long").val(); //緯度

                FarmObj.OutSide = $('#Outside').is(":checked"); //灌區外
                FarmObj.OutSideStr = '';
                FarmObj.IsApplied = $('#IsApplied').is(':checked'); //是否重覆申請

                FarmObj.Pcent_Par = $("#Pcent_Par").val(); //持分比例(分母)
                FarmObj.Pcent_Chd = $("#Pcent_Chd").val(); //持分比例(分子)
                FarmObj.ApplicationStatus = $('#ApplicationStatus').val(); //備註

                var corpary = []; //crop data
                var holderary = []; //holder data
                //Get Corp Data
                $('#CropTable tr:gt(1)').each(function () {
                    var corpName = $(this).find('#td_cname').text();
                    var corpCode = $(this).find('#hidden_corpcode').val();
                    if (corpName != undefined && corpCode != undefined) {
                        var CorpObj = new Object();
                        CorpObj.corpcode = corpCode;
                        CorpObj.corpname = corpName;
                        corpary.push(CorpObj);
                    }
                });
                FarmObj.Corp = corpary;
                FarmObj.CorpCount = corpary.length;
                FarmObj.Cpp = corpary;
                //FarmObj.Crop = corpary;
                //FarmObj.CropCount = corpary.length;
                //alert(corpary.length);
                //alert(corpary[0].corpname);
                //alert(FarmObj.Corp[0].corpname);
                //alert(FarmObj.CorpCount);
                //Get Holder Data
                $('#HolderTable tr:gt(1)').each(function () {
                    var Name = $(this).find('#td_holdname').text();
                    var IDNO = $(this).find('#td_holdIDNo').text();
                    var Addr = $(this).find('#td_holdAddr').text();
                    var PerC = $(this).find('#td_holdPer').text().split("/")[0];
                    var PerP = $(this).find('#td_holdPer').text().split("/")[1];
                    var Area = $(this).find('#td_holdArea').text();

                    //alert(IDNO);
                    if (Name != ''/* && IDNO != ''*/) {
                        var HolderObj = new Object();
                        HolderObj.name = Name;
                        HolderObj.id = IDNO;
                        HolderObj.addr = Addr;
                        HolderObj.perP = PerP;
                        HolderObj.perC = PerC;
                        HolderObj.area = Area;
                        holderary.push(HolderObj);
                    }
                });
                //alert(holderary.length);
                
               
                FarmObj.Holder = holderary;
                
                FarmObj.HolderCount = holderary.length;
                //alert(FarmObj.Corp[0].corpcode);
                //-----------------------------------------------------------------------------------

                //$('#FarmTable').AddFarm(LandNo, sectName, sectCode, cityName, cityCode, townName, townCode,
                //                        LtypeName, LtypeCode, Farea, Barea, Lat, Long, Outside, IsApplied, Par, Chd, FarmStatus);
                jQuery.postJson = function (url, data, callback, type) {
                    //alert("postjason");
                    //alert(data.Corp[0].corpname);
                    //debugger;
                    if ($.isFunction(data)) {
                        type = type || callback;
                        callback = data;
                        data = undefined;
                    }
                    return jQuery.ajax({
                        url: url,
                        type: "POST",
                        dataType: type,
                        contentType: "application/json",
                        data: typeof (data) == "string" ? data : JSON.stringify(data),
                        success: callback
                    });
                };

                if (FarmStatus == 1) { //新增
                    //alert(FarmObj.IsApplied);
                    $.EnableBlockUI('寫入中...');
                    //console.log(JSON.stringify(FarmObj));
                    //alert("add");
                    $.postJson('@Url.Action("CreateSingleData", "FarmLand")', FarmObj, function (data) {
                        if (data == 'Success') {
                            $('#grid').trigger("reloadGrid", [{ current: true }]); //重新載入jqGrid
                            clearAllTxt();
                            $.DisableBlockUI();
                            $('#btn_AddFarm').after(
                                '<div id="alert_FarmerModifySuccess" class="alert alert-success fade in" style="width:200px;">' +
                                    '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                                    '<strong>新增成功!</strong> 資料已完成新增。' +
                                '</div>'
