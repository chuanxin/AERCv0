    function CombinString(title, latlng, imgUrl) {
        return '<h4>' + title + '</h4>' +
            '<div><span style="font-size:14px;">' + latlng + '</span></div>' +
            '<div style="width:150px;"><img src="~/' + imgUrl + '" /></div>';
    }

    $(function () {
        //var latlng = new google.maps.LatLng(24.985, 121.240);
        //google.maps.event.addDomListener(window, 'load', initialize);
        var count = 0;
        //initialize(latlng);
        //頁面載入時，標記google map 點位
        $('#tb_DataList table').each(function () {
            //照片類型名稱
            var title = $(this).parent().parent().prev('tr').find('td').text();
            $(this).find('tr td').each(function () {
                //經緯度
                var spanLatlng = $(this).find('span');
                if (spanLatlng.length > 0) {
                    var img = spanLatlng.next('img');
                    //var Point = new google.maps.LatLng(parseFloat(spanLatlng.text().split(',')[0]), parseFloat(spanLatlng.text().split(',')[1]));
                    //標記
                    if (parseFloat(spanLatlng.text().split(',')[0]) != 0 && parseFloat(spanLatlng.text().split(',')[1]) != 0)
                        //=MarkMap(Point, CombinString($.trim(title), spanLatlng.text(), img.attr('src')));
                    count++;
                }
            });

        });
        if (count == 0) {
            //藉由html5取得位置
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    var coords = position.coords;
                    //latlng = new google.maps.LatLng(coords.latitude, coords.longitude);
                    //initialize(latlng);
                }),
                function (error) {
                    //var latlng = new google.maps.LatLng(24.985, 121.240);
                    //initialize(latlng);
                }
            }
        }
        $('#AdminID').change(function () {
            //alert($('#AdminID').val());
        });

        //送出，前往下個步驟
        $('#btn_SaveExamine').click(function () {
            if (!$('#form_Examine').validate().form()) {
                return false;
            }
            var Data = $('#form_Examine').AddExamine();
            jQuery.postJson = function (url, data, callback, type) {
                if ($.isFunction(data)) {
                    type = type || callback;
                    callback = data;
                    data = undefined;
                }
                return jQuery.ajax({
                    url: url,
                    type: "POST",
                    dataType: type,
                    contentType: "application/json",
                    data: typeof (data) == "string" ? data : JSON.stringify(data),
                    success: callback
                });
            };
            if (Data != false) {
                $.EnableBlockUI('寫入中...');
                //儲存至後端資料庫
                $.postJson("@Url.Action("CreateData", "Examine")", Data, function (res) {
                    if (res == 'Success') {
                        //$('#btn_Save').attr('disabled', 'disabled');
                        //alert('資料儲存成功。');
                        //window.location.href = "../BudgetBook/Create";
                        window.location.href = "../ApplyStep/Index";
                    }
                    else {
                        $.DisableBlockUI();
                        alert(res);
                    }
                });

            } else
                alert('至少輸入一筆資料。');
        });
        //修改資料
        $('#btn_ModifyExamine').click(function () {
            if (!$('#form_Examine').validate().form()) {
                return false;
            }
            var Data = $('#form_Examine').AddExamine();
            jQuery.postJson = function (url, data, callback, type) {
                if ($.isFunction(data)) {
                    type = type || callback;
                    callback = data;
                    data = undefined;
                }
                return jQuery.ajax({
                    url: url,
                    type: "POST",
                    dataType: type,
                    contentType: "application/json",
                    data: typeof (data) == "string" ? data : JSON.stringify(data),
                    success: callback
                });
            };
            $('#alert_ExamineModifySuccess').alert('close');
            $('#alert_ExamineModifyFail').alert('close');
            if (Data != false) {
                $.EnableBlockUI('寫入中...');
                //儲存至後端資料庫
                $.postJson("@Url.Action("CreateData", "Examine")", Data, function (res) {
                    if (res == 'Success') {
                        $('#btn_ModifyExamine').after(
                        '<div id="alert_ExamineModifySuccess" class="alert alert-success fade in" style="width:200px;">' +
                            '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                            '<strong>更新成功!</strong> 資料已完成修改。' +
                        '</div>'
                        );
                    }
                    else {
                        $('#btn_ModifyExamine').after(
                        '<div id="alert_ExamineModifyFail" class="alert alert-error fade in" style="width:200px;">' +
                            '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                            '<strong>更新失敗!</strong> 資料未修改。' +
                        '</div>'
                        );
                        alert(res);
                    }
                    $.DisableBlockUI();
                });

            } else
                alert('至少輸入一筆資料。');
        });

        //略過此步驟
        $('#btn_PassExamine').click(function () {
            $.getJSON('../Examine/PassData', function (res) {
                $.EnableBlockUI('載入中...');
                if (res == 'Success') {
                    window.location.href = "../ApplyStep/Index";
                } else {
                    $.DisableBlockUI();
                    alert(res);
                }
            });
        });

        //日期選擇器
        $('#EDate').datepicker({
            showOn: "button",
            buttonImage: "@Url.Content("~/Content/images/calendar.png")",
            buttonImageOnly: true
        });
        //繫結檔案上傳事件
        $('.divImg').bindData();
        $('input[type="file"]').fileBindData();

    });
</script>
@using (Ajax.BeginForm(null, null, new AjaxOptions { UpdateTargetId = "UpdateDiv" }, new { id = "form_Examine" }))
{
    <div id="UpdateDiv" align="center">
        <div id="div_Map" style="width: 520px; height: 300px;" align="center"></div>
        <table id="tb_DataList" border="1" class="dashTable" align="center" style="width:100%;">
            @foreach (var item in Model.ListFileTypeList)
            {
                <thead>
                    <tr id="tr_@item.FileType">
                        <th>
                            @item.FileTypeCNS
                        </th>
                    </tr>
                </thead>
                <tr>
                    <td>
                        <table id="tb_sub_@item.FileType" border="1" class="dashTable" align="center" width="80%">
                            @if (Model.EFileList.Count > 0)
                            {
                                int k = 0;
                                <tr>
                                    @for (int j = 0; j < Model.EFileList.Count; j++)
                                    {
                                        if (Model.EFileList[j].FileType == item.FileType)
                                        {
                                            k++;
                                            <td>
                                                <div id="div_image" class="divImg" style="width:225px; height:200px;">
                                                    
                                                    <span style="font-size:14px;">@Model.EFileList[j].Coordinate</span>
                                                    <img src="@Model.EFilePath/@Session["MapNo"]/@Model.EFileList[j].Filepath" />
                                                    <a id="@Model.EFileList[j].Filepath.Split('.')[0].Split('_')[1]" href="javascript: void(0)" onclick="DelImg('@Model.EFileList[j].Filepath.Split('.')[0].Split('_')[1]')">刪除</a>
                                                </div>
                                            </td>
                                            if (k > 3)
                                            {
                                            <tr></tr>
                                                k = 0;
                                            }
                                        }
                                    }
                                    <td>
                                        <div id="new_div_image" class="divImg" style="width:225px; height:300px;">
                                        </div>
                                        <input type="file"/>
                                    </td>
                        </tr>
                            }
                            else
                            {
                                <tr>
                                    <td>
                                        <div id="div_image_@item.FileType" class="divImg" style="width:225px; height:200px;">
                                        </div>
                                        <input type="file"/>
                                    </td>
                                </tr>
                            }
                        </table>
                        </td>
                        </tr>
            }
            </table>
        </div>

        <table border="1" class="dashTable" align="center" style="width:100%;">
            <tr>
                <td class="td_style">勘察人員</td>
                <td>
                    <div class="control-group">
                        <div class="controls">
                            @Html.DropDownListFor(model => model.AdminID, new SelectList((System.Collections.IEnumerable)ViewBag.Admin, "Value", "Text", Model.AdminID))
                            @Html.ValidationMessageFor(model => model.AdminID, null, new { @class = "help-inline" })
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="td_style">勘察結果</td>
                <td>
                    @Html.RadioButton("Result", 0, Model.Result == 0 ? true : false) 不符合
                    @Html.RadioButton("Result", 1, Model.Result == 1 ? true : false) 符合申請
                    @Html.RadioButton("Result", 2, Model.Result == 2 ? true : false) 其他
                </td>
            </tr>
            <tr>
                <td class="td_style">原因</td>
                <td>
                    <div class="control-group">
                        <div class="controls">
                            @Html.TextAreaFor(model => model.Reason)
                            @Html.ValidationMessageFor(model => model.Reason, null, new { @class = "help-inline" })
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="td_style">勘查日期</td>
                <td>
                    <div class="control-group">
                        <div class="controls">
                            @Html.TextBoxFor(model => model.EDate, new { Value = Model.EDate.ToString("yyyy/MM/dd"), @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.EDate, null, new { @class = "help-inline" })
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="td_style">備註</td>
                <td>
                    @Html.TextAreaFor(model => model.Note)
                </td>
            </tr>
        </table>
    if(Model.Step < 8)
    {
        if (!Model.IsModify)
        {
            <input id="btn_SaveExamine" type="button" value="送出，前往下個步驟" class="btn" />
            <input id="btn_PassExamine" type="button" value="略過>>" class="btn" />
        }
        else
        {
            <input id="btn_ModifyExamine" type="button" value="修改現場勘查" class="btn" />
        }
    }
}