<script type="text/javascript">
    ResetTimeout();
    (function ($) {
        $.fn.bindData = function () {
            //拖拉上傳
            $(this).bind('dragover', function (event) { //滑鼠移至上方時
                eventStop(event);
                $(event.target).addClass('divImgCss');
            }).bind('dragleave', function (event) { //滑鼠移開時
                eventStop(event);
                $(event.target).removeClass('divImgCss');
            }).bind('drop', function (event) { //滑鼠拖放時
                eventStop(event);
                $(event.target).removeClass('divImgCss');
                var fileType = $(event.target).parent().parent().parent().parent().attr('id').split('_')[2];
                var typeName = $(event.target).parent().parent().parent().parent().parent().parent().prev('tr').text();
                //取得檔案資訊
                var files = event.originalEvent.dataTransfer.files;
                //debugger;
                //檢查檔案大小、過濾檔案類型
                var imageFiles = $.map(files, function (f, i) {
                    //console.log(f.size);                    
                    if (f.size > 3145728) {
                        alert(`${f.name}大小超過3M`);
                        return null;
                    } 
                    if (f.type.indexOf("image") < 0) {
                        alert(`${f.name}檔案類型不對!!`);
                        return null
                    }
                    return f;
                });
                //var imageFiles = $.map(/*files*/filesCheckZise, function (f, i) { //過濾檔案類型
                //    return f.type.indexOf("image") == 0 ? f : null;
                //});
                if (imageFiles.length == 0) {
                    alert("無檔案上傳!!");
                    //e.target.value = null;
                    return false;
                }
                UploadImg(imageFiles, $(event.target), fileType, $.trim(typeName));
            });

        };
        $.fn.fileBindData = function () {
            //傳統上傳
            $(this).change(function (e) {
                //debugger;
                var files = e.target.files;
                var imageFiles = $.map(files, function (f, i) { //過濾檔案類型
                    return f.type.indexOf("image") == 0 ? f : null;
                });
                if (imageFiles.length == 0) {
                    alert("檔案格式不正確!!");
                    e.target.value = null;
                    return false;
                }
                if (files[0].size > 3145728) {
                    alert("檔案過大，超過3M!!");
                    e.target.value = null;
                    return false;
                }

                var fileType = $(this).parent().parent().parent().parent().attr('id').split('_')[2];
                var typeName = $(this).parent().parent().parent().parent().parent().parent().prev('tr').text();
                
                UploadImg(imageFiles, $(this).prev('div'), fileType, typeName);
            });
        };
    })(jQuery);
    function eventStop(event) {
        event.stopPropagation();
        event.preventDefault();
    }
    function UploadImg(imageFiles, divID, fileType, typeName) {
        //依據各檔案，取得DataURI
        $.each(imageFiles, function (i, file) {
            //使用File API讀取圖檔內容轉為DataUri
            var reader = new FileReader();
            reader.onload = function (e) {
                divID.append('<img src="@Url.Content("~/Content/images/ajax-loader.gif")" />');
                //debugger;
                var data = e.target.result;
                ajaxUploadImg(divID, file, fileType, typeName);
                divID.next('input[type="file"]').remove();
                //每行超過4張圖片則換行
                if (divID.parent().parent().find('td').length > 3) {
                    divID.parent().parent().parent().append('<tr><td>' +
                                                                '<div class="divImg" style="width:225px; height:200px;">' +
                                                                '</div>' +
                                                                '<input type="file" />' +
                                                            '</tr></td>');
                    //繫結DIV拖拉上傳事件
                    divID.parent().parent().next('tr').find('td div').bindData();
                    divID.parent().parent().next('tr').find('td input[type="file"]').fileBindData();
                    //重新指定DIV實體
                    divID = divID.parent().parent().next('tr').find('td div');
                } else {
                    divID.parent().parent().append('<td>' +
                                                        '<div class="divImg" style="width:225px; height:200px;">' +
                                                        '</div>' +
                                                        '<input type="file" />' +
                                                    '</td>');
                    //繫結DIV拖拉上傳事件
                    divID.parent().next('td').find('div').bindData();
                    divID.parent().next('td').find('input[type="file"]').fileBindData();
                    //重新指定DIV實體
                    divID = divID.parent().next('td').find('div');
                }
            };
            reader.readAsDataURL(file);
            $('#btn_SaveExamine').attr('disabled', false);
        });
    }
    function ajaxUploadImg(divID, data, fileType, typeName) {
        $.ajax({
            type: "POST",
            url: "@Url.Action("FileUpload", "Examine")" + "?file=" + data.name + '&fileType=' + fileType,
            contentType: data.type,
            processData: false, //只上傳原始資料(重要)
            data: data,
            success: function (res) {
                var coords = res.split(';')[0];
                var filePath = res.split(';')[1];
                var btnIDAry = filePath.split('\\');
                var btnID = btnIDAry[btnIDAry.length - 1].split('.')[0].split('_')[1];
                divID.find('img').remove();
                divID.append('<span style="font-size:14px;">' + coords + '</span><img width="225px" height="150px" src="' + filePath + '"/>');
                divID.append('<a id="' + btnID + '" onclick="DelImg(' + btnID + ')" href="javascript: void(0)">刪除</a>');
                //var lat = parseFloat(coords.split(',')[0]);
                //var lng = parseFloat(coords.split(',')[1]);
                //var latlng = new google.maps.LatLng(lat, lng);
                //在地圖上標記
                //if (lat != 0 && lng != 0)
                //    MarkMap(latlng, CombinString(typeName, coords, filePath));
            }
        });
    }
    function DelImg(btnID) {
        if (!confirm('確定刪除？'))
            return false;
        var DelBtn = $('#' + btnID);
        var DelUrl = DelBtn.prev('img').attr('src').split('/'); //刪除的檔名
        //debugger;
        $.ajax({
            type: "POST",
            url: "@Url.Action("DeleteImg", "Examine")" + "?fileName=" + DelUrl[DelUrl.length - 1],
            success: function (res) {
                if (res == 'Success') {
                    var pos = DelBtn.prev().prev('span').text();
                    var ImgHtml = [];
                    var HtmlContent = DelBtn.parent().parent().parent().parent().parent();
                    DelBtn.parent().remove();
                    HtmlContent.find('tr td').each(function () {
                        if ($.trim($(this).html())) {
                            ImgHtml.push($(this).html());
                        }
                    });
                    //清空表格內容
                    HtmlContent.empty();
                    var TableHtml;
                    TableHtml = '<tr>';
                    for (i = 0, count = 1; i < ImgHtml.length; i++, count++) {
                        TableHtml += '<td>' + ImgHtml[i] + '</td>';
                        if (count % 4 == 0) {
                            TableHtml += '</tr><tr>';
                        }
                    }
                    TableHtml += '</tr>';
                    HtmlContent.append(TableHtml);
                    //var position = new google.maps.LatLng(parseFloat(pos.split(',')[0]), parseFloat(pos.split(',')[1]));
                    //DelMarker(position);
                }
            }
        });
    }

