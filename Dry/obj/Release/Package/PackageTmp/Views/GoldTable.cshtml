@*@model Dry.Models.ViewModel.BudgetBookView*@
@{
    ViewBag.Title = "推廣管路灌溉設施管理資料庫";
}

@{
    string ItemAmount = string.Empty;
    string ItemPrice = string.Empty;
    string TotalPrice = string.Empty;
    string Memo = string.Empty;
}

@*style="display:none"*@

<div id="div_EngBudget" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="EngBudgetLabel" aria-hidden="true">
    <div class="modal-header">
        <h3 id="EngBudgetLabel">報表列印 - 工程預算書</h3>
    </div>
    <div class="modal-body">
        <table>
            <tr>
                <td>
                    @using (Html.BeginForm("ExportExcel", "Budgetbook"))
                    {
                        <button id="BtnExcel" type="submit" class="btn" title="匯出">
                            <img src="~/Content/images/ms_excel.ico" style="width:65px" />
                            <br />
                            匯出Excel
                        </button>
                    }
                </td>
            </tr>

        </table>
    </div>
    <div class="modal-footer">
        <input type="button" value="關閉" class="btn" data-dismiss="modal" />
    </div>
</div>

