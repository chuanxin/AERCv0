<div id="div_VerifyBook" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="EngBudgetLabel" aria-hidden="true">
    <div class="modal-header">
        <h3 id="EngBudgetLabel">報表列印 - 驗收報告書</h3>
    </div>
    <div class="modal-body">
        <table>
            <tr>
                <td>
                    @using (Html.BeginForm("ExportVerifyBook", "Budgetbook"))
                    {
                        <button id="BtnExcel" type="submit" class="btn" title="匯出">
                            <img src="~/Content/images/ms_excel.ico" style="width:65px" />
                            <br />
                            匯出Excel
                        </button>
                    }
                </td>
            </tr>

        </table>
    </div>
    <div class="modal-footer">
        <input type="button" value="關閉" class="btn" data-dismiss="modal" />
    </div>
</div>



<table id="gold" border="1" class="dashTable" align="center" width="100%">
    <thead>
        <tr>
            <th colspan="2" width="120px">設施項目</th>
            <th width="120px">說明</th>
            <th width="50px">單位</th>
            <th width="50px">數量</th>
            <th width="50px">單價</th>
            <th width="60px">總價</th>
            <th width="80px">附註(黃金)</th>
        </tr>
    </thead>
    <tr>
        <td colspan="2" class="td_style">A. 田間管路設施費</td>
        <td class="number_center">(1) + (2)</td>
        <td class="number_center">全</td>
        <td></td>
        <td></td>
        <td class="number_right">@Model.PipingTotal</td>
        <td></td>
    </tr>

    <tr>
        <td colspan="2" class="td_style">&nbsp;&nbsp;(1)材料費</td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="number_right">@Model.PipingMatMoney</td>
        <td></td>
    </tr>
    <tr>
        <td colspan="2" class="td_style">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;田間主管1(L1)</td>
        <td></td>
        <td class="number_center">支</td>
        @if (Model.L1 != null)
        {
            ItemAmount = Model.L1.ItemAmount;
            ItemPrice = Model.L1.ItemPrice;
            TotalPrice = Model.L1.TotalPrice;
            Memo = Model.L1.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">@ItemPrice</td>
        <td class="number_right">@TotalPrice</td>
        <td>@Memo</td>
    </tr>
    <tr>
        <td colspan="2" class="td_style">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;田間主管2(L2)</td>
        <td></td>
        <td class="number_center">支</td>
        @if (Model.L2 != null)
        {
            ItemAmount = Model.L2.ItemAmount;
            ItemPrice = Model.L2.ItemPrice;
            TotalPrice = Model.L2.TotalPrice;
            Memo = Model.L2.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">@ItemPrice</td>
        <td class="number_right">@TotalPrice</td>
        <td>@Memo</td>
    </tr>
    <tr>
        <td colspan="2" class="td_style">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;灌溉系統</td>
        <td></td>
        <td class="number_center">式</td>
        @if (Model.IrrSystem != null)
        {
            ItemAmount = Model.IrrSystem.ItemAmount;
            ItemPrice = Model.IrrSystem.ItemPrice;
            TotalPrice = Model.IrrSystem.TotalPrice;
            Memo = Model.IrrSystem.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">
            @ItemPrice
        </td>
        <td class="number_right">@TotalPrice</td>
        <td>@Memo</td>
    </tr>
    <tr>
        <td colspan="2" class="td_style">&nbsp;&nbsp;(2)工作費</td>
        <td></td>
        <td class="number_center">公頃</td>
        @if (Model.Work != null)
        {
            ItemAmount = Model.Work.ItemAmount;
            ItemPrice = Model.Work.ItemPrice;
            TotalPrice = Model.Work.TotalPrice;
            Memo = Model.Work.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">@ItemPrice</td>
        <td class="number_right">@TotalPrice</td>
        <td>@Memo</td>
    </tr>
    <tr>
        <td colspan="2" class="td_style">B. 規劃設計費</td>
        <td class="number_center"> A * 2.0 % </td>
        <td class="number_center">式</td>
        @if (Model.Planning != null)
        {
            ItemAmount = Model.Planning.ItemAmount;
            ItemPrice = Model.Planning.ItemPrice;
            TotalPrice = Model.Planning.TotalPrice;
            Memo = Model.Planning.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">@ItemPrice</td>
        <td class="number_right">@TotalPrice</td>
        <td>@Memo</td>
    </tr>
    <tr>
        <td colspan="2" class="td_style">C. 調控設施</td>
        <td class="number_center">依計畫補助標準</td>
        <td class="number_center">式</td>
        @if (Model.RegulatedFac != null)
        {
            ItemAmount = Model.RegulatedFac.ItemAmount;
            ItemPrice = Model.RegulatedFac.ItemPrice;
            TotalPrice = Model.RegulatedFac.TotalPrice;
            Memo = Model.RegulatedFac.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">@ItemPrice</td>
        <td class="number_right">@TotalPrice</td>
        <td>
            @foreach (var cntrlcnt in Memo.Split('#'))
            {
                <font>@cntrlcnt</font>
                <br />
            }
        </td>
       
    </tr>

    <tr>
        <td colspan="2" class="td_style">D. 動力設施</td>
        <td class="number_center">依計畫補助標準</td>
        <td class="number_center">座</td>
        @if (Model.Engine != null)
        {
            ItemAmount = Model.Engine.ItemAmount;
            ItemPrice = Model.Engine.ItemPrice;
            TotalPrice = Model.Engine.TotalPrice;
            Memo = Model.Engine.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">@ItemPrice</td>
        <td class="number_right">@TotalPrice</td>

        <td>
            @foreach (var engcnt in Memo.Split('#'))
            {
                <font>@engcnt</font>
                <br />
            }
        </td>
    </tr>
    <tr>
        <td colspan="2" class="td_style">E. 蓄水池</td>
        <td class="number_center">依計畫補助標準</td>
        <td class="number_center">座</td>
        @if (Model.Pool != null)
        {
            ItemAmount = Model.Pool.ItemAmount;
            ItemPrice = Model.Pool.ItemPrice;
            TotalPrice = Model.Pool.TotalPrice;
            Memo = Model.Pool.Memo;
        }
        else
        {
            ItemAmount = string.Empty;
            ItemPrice = string.Empty;
            TotalPrice = string.Empty;
            Memo = string.Empty;
        }
        <td class="number_center">@ItemAmount</td>
        <td class="number_right">@ItemPrice</td>
        <td class="number_right">@TotalPrice</td>

        <td>
            @foreach (var poolcnt in Memo.Split('#'))
            {
                <font>@poolcnt</font>
                <br />
            }
        </td>
    </tr>
    <tr>
        <td colspan="2" class="number_center" class="td_style">合計</td>
        <td colspan="5" class="number_right">新台幣 @Model.Total 元整</td>
        <td></td>
    </tr>
    </table>
<table class="dashTable" style="width:100%;">
    <tr>
        <td colspan="2" class="number_center" class="td_style">農戶配合款</td>
        <td> >=(A) x 30%</td>
        <td class="number_right">@Model.FarmerPay</td>
        <td rowspan="6" class="number_center">報<br />表<br />列<br />印</td>
        <td rowspan="6">
            @*<td rowspan="7" class="number_center">
                @using (@Html.BeginForm("ExportExcel", "Budgetbook"))
                {
                    <button id="BtnExcel" type="submit" value="工程預算書">
                        <img src="~/Content/images/excel.jpg" width="80" height="80" />
                    </button>
                }
            </td>*@
            <ul>
                <li>
                    <a id="btn_EngBudget" href="#div_EngBudget" data-toggle="modal">工程預算書</a>
                </li>
                <li>
                    <a id="btn_Proxy" href="#div_Proxy" data-toggle="modal">規劃委託書</a>
                </li>
                <li>
                    <a id="btn_AcceptAffidavit" href="#div_AcceptAffidavit" data-toggle="modal">接受補助設置旱作管路灌溉設施切結書</a>
                </li>
                <li>
                    <a id="btn_FitAffidavit" href="#div_FitAffidavit" data-toggle="modal">配合農時提前施設切結書</a>
                </li>
                <li>
                    <a id="btn_Complete" href="#div_Complete" data-toggle="modal">竣工報驗書</a>
                </li>
                <li>
                    <a href="~/Download/DesignStandard.xlsx">灌溉系統設計標準</a>
                </li>
                <li>
                    <a id="btn_CtrlMat" href="#div_CtrlMat" data-toggle="modal">調節控制材料數量計算表</a>
                </li>
                <li>
                    <a id="Btn_VerifyBook" href="#div_VerifyBook" data-toggle="modal">驗收報告書</a>
                </li>
            </ul>
        </td>
</tr>

    <tr>
        <td rowspan="5" class="td_style">政府補助款</td>
        <td rowspan="3" class="td_style">農戶請領款</td>
        <td class="number_center" class="td_style">農水署補助款</td>
        
        <td class="number_right">@Model.GovPay_Pay </td>
    </tr>
    <tr>
        <td class="number_center" class="td_style">瑠公協助款</td>

        <td class="number_right">@Model.LiuPay</td>
    </tr>
    <tr>
        <td class="number_center" class="td_style">七星協助款</td>
        
        <td class="number_right">@Model.GoldPay</td>
    </tr>
    <tr>
        <td class="number_center" class="td_style">規劃設計費</td>
        
        <td colspan="2" class="number_right">@Model.GovPay_Planning</td>
    </tr>
    <tr>
        <td  class=" number_center" class="td_style">小計</td>
        
        <td colspan="2" class=" number_right">@Model.GovPay_Sum</td>
    </tr>


    @*<tr>
        <td colspan="2" class="number_center" class="td_style">合  計</td>
        
        <td colspan="2" class="number_right">@Model.Total</td>
    </tr>*@
    <tr>
        <td colspan="2" class="number_center" class="td_style">本設施預算總計</td>
        <td colspan="5" class="number_center">新台幣 @Model.ChineseMoney 元整</td>
    </tr>
</table>

