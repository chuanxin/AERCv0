@{
    ViewBag.Title = "更改密碼";
}

<h2>更換密碼</h2>
@using (Html.BeginForm("ChangePwd", "UserManage", FormMethod.Post, new {id = "form1" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="token" value="@ViewBag.token" />
    @*<label for="pwd">舊密碼</label>
    <input type="password" id="pwd" name="pwd" required />*@
    <label for="pwd1">新密碼</label>
    <input type="password" id="pwd1" name="pwd1" required />
    <label for="pwd2">確認新密碼</label>
    <input type="password" id="pwd2" name="pwd1" required />
    <br>
    <input type="submit" class="btn btn-primary" value="確認" />
}

<div class="jumbotron">
    <h3>密碼規則說明</h3>
    <ul>
        <li><strong>1.密碼長度不可少於8碼</strong></li>
        <li><strong>2.密碼請使用大小寫英文、數字符號組合</strong></li>
    </ul>   
</div>

@section scripts{
    <script src="~/Scripts/_ChgPwd.js"></script>
    <script>
        $("#form1").on("submit", function () {
            
            const d = CheckInput($("#pwd1").val().trim());
            //debugger;
            //console.log(d);
            if (! d.pass) {
                alert(d.error);
                return false;
            }

        })
        $("#pwd2").on("blur", function () {
            if ($(this).val() != $("#pwd1").val()) {
                alert("新密碼與確認新密碼不符");
                $(this).val("");
            }
        })    

        if ("@TempData["msg"]" != "") {
            alert("@TempData["msg"]");
        }
    </script>
}