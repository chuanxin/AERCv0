@{
    ViewBag.Title = "推廣管路灌溉設施管理資料庫";
    @Styles.Render("~/jqgrid/css")
    @Scripts.Render("~/bundles/jqueryjqgrid")
}
@model Dry.Models.ViewModel.SectionView

<script type="text/javascript">
    $(function () {
        $('#CityCode').change(function () {
            $.EnableBlockUI('');
            $.getJSON('@Url.Action("GetTownDDL", "Section")' + '?CityCode=' + $('#CityCode option:selected').val(), function (data) {
                var TownDDL = $('#TownId');
                TownDDL.empty();
                for (i = 0; i < data.length; i++) { 
                    TownDDL.append('<option value="' + data[i].Value + '">' + data[i].Text + '</option>');
                }
                $.DisableBlockUI('');
            });
        });
        $('#moi_query').click(function () {
            $.DisableBlockUI('');
        });
        var grid = $('#grid'); 
        var TownId = $('#TownId option:selected').val();
        
        grid.jqGrid({
            url: '@Url.Action("GetSectionList", "Section")' + '?Town_Id=' + TownId,
            datatype: 'json',
            jsonReader: {
                repeatitems: false,
                id: 'Section_Id'
            },
            mtype: 'GET',
            colNames: ['', '地段代碼', '地段', '小段',''],
            colModel: [
                {
                    name: 'myac', width: 55, align: 'center', fixed: true, sortable: false, resize: false, formatter: 'actions',
                    formatoptions: {
                        keys: true
                    },
                },
                { name: 'Section_Code',width:150, index: 'Section_Code', search: false, editable: true },
                { name: 'Section', width: 100, align: 'left', search: true, editable: true, edittype: 'text', editoptions: { required: true } },
                { name: 'Subsection', width: 100, search: false, editable: true },
                { name: 'Town_Id', width: 100, search: false, editable: true, hidden: true, editoptions: { value: GetTownID } }
            ],
            pager: '#pager',
            //autowidth: true,
            //width: 500,
            height: 'auto',
            rowNum: 20, 
            rowList: [5, 10, 20, 50], 
            sortname: 'Section_Code',
            viewrecords: true,
            rownumbers: true,
            caption: '地段資料管理', 
            loadComplete: function (ids) {
                $('.ui-pg-table table input[type=text]').css('width', '20').css('height', '20'); 
                $('.ui-pg-table table select').css('width', '60').css('height', '30'); 
                $('#pager_center').css('width', '250'); 
                //$('#pager_left').css('width', '250'); 
            },
            editurl: '@Url.Action("EditSection", "Section")',
            subGrid: true,
            subGridOptions: {
                "plusicon": "ui-icon-triangle-1-e",
                "minusicon": "ui-icon-triangle-1-s",
                "openicon": "ui-icon-arrowreturn-1-e"
            },
            
            subGridRowExpanded: function (subgrid_id, row_id) {
                var subgrid_table_id, pager_id;
                subgrid_table_id = subgrid_id + "_t";
                pager_id = "p_" + subgrid_table_id;
                $("#" + subgrid_id).html("<table id='" + subgrid_table_id + "' class='scroll'></table><div id='" + pager_id + "' class='scroll'></div>");
                var sub_grid = $("#" + subgrid_table_id).jqGrid({
                    url: '@Url.Action("GetLandNumberList", "Section")' + '?Section_Id=' + row_id,
                    datatype: "json",
                    mtype: 'GET',
                    jsonReader: {
                        repeatitems: false,
                        id: 'Land_Number_Id'
                    },
                    colNames: ['', 'Land_Number_Id', 'Section_Id', '地號', '經度', '緯度'],
                    colModel: [
                        {
                            name: 'submyac', width: 55, align: 'center', fixed: true, sortable: false, resize: false, formatter: 'actions',
                            formatoptions: {
                                keys: true,
                                editbutton: true,
                                delbutton: true,
                                onEdit: function () {

                                }
                            },
                        },
                        { name: "Land_Number_Id", index: "Land_Number_Id", hidden: true },
                        { name: "Section_Id", index: "Section_Id", hidden: true, editable: false },
                        { name: "Land_Code", index: "Land_Code", width: 120, align: "center", sortable: false, editable: true, editrules: { required: true } },
                        { name: "Longitude", index: "Longitude", width: 80, align: "right", sortable: false, editable: true, edittype: 'text', editrules: { required: true, number: true } },
                        { name: "Latitude", index: "Latitude", width: 80, align: "right", sortable: false, editable: true, edittype: 'text', editrules: { required: true, number: true } },
                    ],
                    rowNum: 10, 
                    rowList: [5, 10, 20, 50], 
                    pager: pager_id,
                    sortname: 'Land_Code',
                    viewrecords: true,
                    rownumbers: true,
                    //sortorder: "asc",
                    height: '100%',
                    loadComplete: function (ids) {
                        $('.tablediv input[type=text]').css('width', '20').css('height', '20'); 
                        $('.tablediv select').css('width', '60').css('height','30'); 
                        $('[id$="_t_center"]').css('width', '240'); 
                    },
                    editurl: '@Url.Action("EditLandNumber", "Section")'
                });
                $("#" + subgrid_table_id).jqGrid('navGrid', "#" + pager_id,
                    { edit: false, add: true, del: false, search: false },
                    {}, /*edit*/
                    {
                        url: '@Url.Action("AddLandNumber", "Section")' + '?Section_Id=' + row_id,
                        mtype: 'GET',
                        closeOnEscape: true,
                        closeAfterAdd: true
                    }, /*add*/
                    {}, /*delete*/
                    {}, /*search*/
                    {} /*view*/
                    )
            }
        });
        grid.navGrid('#pager',
            { edit: false, add: true, del: false, search: false },
            {}, /*edit*/
            {
                url: '@Url.Action("AddSection", "Section")',
                closeOnEscape: true,
                closeAfterAdd: true/*,
                mtype: 'GET'*/
            }, /*add*/
            {}, /*delete*/
            {}, /*search*/
            {} /*view*/
        );
        
        $('#TownId').change(function () {
            $('#grid').setGridParam(
                { url: '@Url.Action("GetSectionList", "Section")' + '?Town_Id=' + $(this).val() }
                ).trigger("reloadGrid"); 
        });

        function GetTownID() {
            return $('#TownId option:selected').val();
        }
    });
</script>

<h2>地段代碼管理</h2>
縣市：
@Html.DropDownListFor(model => model.CityCode, Model.CityDDL, new { style = "width: 100px;" })
鄉鎮：
@Html.DropDownListFor(model => model.TownId, Model.TownDDL, new { style = "width: 100px;" })
@*地段：
@Html.DropDownListFor(model => model.SectionCode, Model.SectionDDL, new { style = "width: 100px;" })*@
<div class="row-fluid">
    <a id="moi_query" href="http://www.land.moi.gov.tw/ngis/chhtml/query1.asp" target="_blank">內政部地政司土地段名代碼查詢系統</a>
</div>
<div id="div_Content">
    <table id="grid"></table>
    <div id="pager"></div>
</div>