@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Dry.Models.ViewModel.SlopelandQueryView

<script>
    var city = '';
    var town = '';
    var section = '';
    $(function () {

        $('#CityCode').change(function () {
            var val = $('#CityCode option:selected').val();
            city = val;
            GetTownDDL(val);
        });
        $('#TownId').change(function () {
            var val = parseInt($('#TownId option:selected').val());
            town = val;
            GetSecDDL(val);
        });
        $('#Section').change(function () {
            var val = $("#Section option:selected").val();
            section = val;
        });
        $('#btn_Query').click(function (event) {
            confirm("系統功能因為提供API服務已停止，請直接點選[行動水保服務網]進行查詢");
            return false;

            $('#tb_result').hide();
            var postStr = $.post('@Url.Action("QueryJS", "SlopelandQuery")', { CityCode: city, TownId: town, Section: section, LandNo: $('#LandNo').val() });

            postStr.done(function (data) {
                //alert($(data).find("#landClass"));
                $('#div_SlopelQueryandMsg').fadeIn();
                for (i = 0; i < data.results.length; i++) {
                    //alert('='+data.results[i].landClass);
                    $('#span_landClass').html(data.results[i].landClass);
                    $('#span_gisBou').html(data.results[i].gisBou);
                    $('#span_inSoilWater').html(data.results[i].inSoilWater);
                }
            }).fail(function () {
                alert('error');
            });
        });
        $('#btnLink1').click(function () {
            window.open("https://serv.ardswc.gov.tw/B/#BLinkMain");
            $.unblockUI('');
        });
        $('#btnLink2').click(function () {
            window.open("https://serv.ardswc.gov.tw/B/");
            $.unblockUI('');
        });
    });
    function GetTownDDL(DDLvalue) {
        $.ajaxSettings.async = false;
        $.getJSON('@Url.Action("GetTownDDLByAjax", "SlopelandQuery")' + '?CityCode=' + DDLvalue, function (data) {
            var TownDDL = $('#TownId');
            TownDDL.empty();
            for (i = 0; i < data.length; i++) { 
                TownDDL.append('<option value="' + data[i].Value + '">' + data[i].Text + '</option>');
            }
        });
    }
    function GetSecDDL(DDLvalue) {
        $.ajaxSettings.async = false;
        $.getJSON('@Url.Action("GetSecDDLByAjax", "SlopelandQuery")' + '?townid=' + DDLvalue, function (data) {
            var sectDDL = $('#Section');
            sectDDL.empty();
            for (i = 0; i < data.length; i++) { 
                sectDDL.append('<option value="' + data[i].Value + '">' + data[i].Text + '</option>');
            }
        });
    }
</script>

