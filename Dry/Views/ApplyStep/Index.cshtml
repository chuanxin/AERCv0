</div>
<script>
    
    
    var RefreshOnly = [false, false, false, false, false, false, false, false, false, false, false, false];

    $(function () {

        var Step = parseInt('@Model.Step');
        $('#div_Step').tabs({
            border: false,
            collapsible: true,
            scrollIncrement: 800,
            onSelect: function (title, index) {
                //UpdateTab(index);
                //alert(index);
                //alert(RefreshOnly[parseInt(index)]);
                
                if ($('#div_Step').tabs('exists', title)) {
                    if (RefreshOnly[index]) {
                        var current_tab = $('#div_Step').tabs('getSelected');
                        current_tab.panel('refresh');
                        //RefreshOnly = true;
                    }

                    //var current_tab = $('#div_Step').tabs('getSelected');
                    //var tab = current_tab.panel('options').tab;
                    //tab.panel('href', GetLoadUrl(index));
                }
                RefreshOnly[index] = true; 
            },
            onUnselect: function (title, index) {
                //alert(title);
                
                //console.log(title);
                $('#div_Step_' + (index + 1)).empty();
            }
        });
        function GetLoadUrl(step) {
            switch (step) {
                case 0:
                    return '@Url.Action("Index","Farmer")';
                case 1:
                    return '@Url.Action("CreateFarm", "FarmLand")';
                case 4/*2*/:
                    return '@Url.Action("CreateFarmerSys", "FarmerSys")';
                case 2/*3*/:
                    return '@Url.Action("Create", "ApplyEngine")';
                case 3/*4*/:
                    return '@Url.Action("Create", "ApplyPool")';
                case 5:
                    return '@Url.Action("Index", "Ctrl")';
                case 6:
                    return '@Url.Action("Index", "Examine")';
                case 7:
                    return '@Url.Action("Create", "BudgetBook")';
                case 8:
                    return '@Url.Action("ChangDesign", "ChgDesign")';
                case 9:
                    return '@Url.Action("CompletionReport", "FacilityReport")';
                case 10:
                    return '@Url.Action("CreateVerify", "Verify")';
                case 11:
                    return '@Url.Action("Efile", "Efile")';
            }
        }

        if (Step < 1) { 
            for (var i = 0; i <= 11; i++) { 
                if (i > Step) {
                    $('#div_Step').tabs('disableTab', i);
                }
            }
        } else if (Step <= 7) { 
            for (var i = 8; i <= 10; i++) {
                $('#div_Step').tabs('disableTab', i);
            }
        }
        if ('@Session["UnitID"].ToString()' == '13' || '@Session["UnitID"].ToString()' == '7') {
            if ('@Session["Status"].ToString()' == 'False') {
                for (var i = 2; i <= 10; i++) {
                    $('#div_Step').tabs('disableTab', i);
                }
            }
        }
        //$('#span_StepHeader').html(Step + 1);
        $('#div_Step').tabs('select', Step); 
        //RefreshOnly = true;
        @*$('#div_Step_' + (Step + 1)).panel({
            href: '@Model.Url'
        });*@
        //$('#div_Step_' + (Step + 1)).css('height', 'auto');
        //var p = $('#div_Step').tabs('getSelected');
        //p.panel('refresh');
    });
    function UpdateTab(step) {
        alert(step);
        @*$.getJSON('@Url.Action("GetSelectedStepData", "ApplyStep")' + '?step=' + step, function (res) {
            //alert(res);
            //UpdateTab(res);
        });
        //alert(url);
        var current_tab = $('#div_Step').tabs('getSelected');
        //$('#div_Step').tabs('update', {
        //    tab: current_tab,
        //    options: {
        //        href: url
        //    }
        //});
        current_tab.panel('refresh');*@
    }
</script>