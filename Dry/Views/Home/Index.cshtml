@model Dry.Models.ViewModel.StatisticHomeView2020
@{
    ViewBag.Title = "推廣管路灌溉設施管理資料庫";
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
<h2>公告資訊</h2>
<div class="content">
    <div class="content_item">
        <div align="center"><h5>@ViewBag.QryYear 年度目前預算書編製情形</h5> </div>
        
        <b>一、農水署經費</b>
        <table class="dashTable">
            <tr class="odd">
                @*<td>預定推廣戶數</td>*@
                <td>預定推廣面積(a)</td>
                <td>預定推廣金額(千元)</td>
                <td>調整推廣金額(千元)(b)</td>
                @*<td>建檔戶數(c)</td>
        <td>建檔面積(d)</td>
        <td>面積達成率%(d/a)</td>*@
                <td>已編預算戶數</td>
                <td>已編預算面積(e)</td>
                <td>已編列補助款(f)</td>
                <td>尚未編列補助款(g)=(b)-(f)</td>
                <td>已驗收戶數</td>
                <td>已驗收面積</td>
                <td>已驗收金額(h)</td>
                <td>面積執行率%(i)=(e)/(a)</td>
                <td>經費執行率%(i)=(f)/(b)</td>
                <td>設計費</td>
            </tr>
            <tr>
                @*<td class="number_right">@Html.DisplayFor(Model => Model.ReservationsofFarmer_coa)</td>預定推廣戶數*@
                <td class="number_right">@Model.ReservationsofFarm_coa</td>
                @*預定推廣面積(a)*@
                <td class="number_right">@Model.ReservationsofMoney_coa</td>
                @*預定推廣金額(千元)*@
                <td class="number_right">@Model.Ch_ReservationsofMoney_coa</td>
                @*調整推廣金額(千元)(b)*@
                @*<td class="number_right">@Model.NumofFarmer_coa</td>建檔戶數(c)*@
                @*<td class="number_right">@Model.NumofFarm_coa.ToString("N4")</td>@*建檔面積(d)*@
                @*<td class="number_right">@Model.ReachOfArea_coa%</td>面積達成率%(d/a)*@
                <td class="number_right">@Model.ProvisionOfFarmer_coa</td>
                @*已編預算戶數*@
                <td class="number_right">@Model.ProvisionOfFarm_coa.ToString("N4")</td>
                @*已編預算面積(e)*@
                <td class="number_right">@Model.ProvisionOfMoney_coa.ToString("N0")</td>
                @*已編列補助款(f)*@
                <td class="number_right">@Model.Unusemoney_coa.ToString("N0")</td>
                @*尚未編列補助款(g)=(b)-(f)*@
                <td class="number_right">@Model.ProvisionofFarmerend_coa</td>
                @*已驗收戶數*@
                <td class="number_right">@Model.ProvisionOfFarmend_coa.ToString("N4")</td>
                @*已驗收面積*@
                <td class="number_right">@Model.ProvisionOfMoneyend_coa.ToString("N0")</td>
                @*已驗收金額(h)*@
                <td class="number_right">@Model.ReachOfArea_coa%</td>
                @*計畫執行率%(i)=(h)/(b)*@
                @if (Model.Ch_ReservationsofMoney_coa > 0)
                {
                    var aa = Math.Round(((double)Model.ProvisionOfMoney_coa / (double)Model.Ch_ReservationsofMoney_coa) * 0.1d, 2);
                    <td class="number_right">@aa%</td>
                }
                else
                {
                    <td class="number_right">0%</td>
                }

                <td class="number_right">@Model.Desinge_coa</td>
                @*設計費*@
            </tr>
        </table>

