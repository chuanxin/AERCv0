                    @*已驗收面積*@
                    <td class="number_right">@Model.ProvisionOfMoneyend_lu.ToString("N0")</td>
                    @*已驗收金額(h)*@
                    <td class="number_right">@Model.ReachOfArea_lu%</td>
                    @*計畫執行率%(i)=(h)/(b)*@
                    @if (Model.ReservationsofMoney_lu > 0)
